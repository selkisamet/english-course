{
 "storyId": "story-b1-012",
 "textHash": "599bcad4c094",
 "source": "manual",
 "sentences": [
  {
   "tr": "Marco Lizbon'a indiğinde bavulunu neredeyse bir saat bekledi ama bavul hiç gelmedi."
  },
  {
   "tr": "Havayolu masasına gitti ve bir form doldurdu."
  },
  {
   "tr": "Görevli, çantasının yanlışlıkla Madrid'e gönderilmiş olduğunu açıkladı."
  },
  {
   "tr": "Marco bir diş fırçası, bir gömlek ve birkaç çift çorap almak zorunda kaldı."
  },
  {
   "tr": "Neyse ki bavul iki gün sonra oteline ulaştı."
  },
  {
   "tr": "O zamandan beri el bagajına her zaman yedek kıyafet koyuyor."
  }
 ],
