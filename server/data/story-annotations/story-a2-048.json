{
 "storyId": "story-a2-048",
 "textHash": "f5ebb11e1033",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen ilkbahar Oliver'ın midesinde kötü bir ağrı vardı ve annesi onu hastaneye götürdü."
  },
  {
   "tr": "Doktor küçük bir ameliyat olması gerektiğini söyledi."
  },
  {
   "tr": "Oliver korkuyordu ama hemşireler ona çok iyi davrandı."
  },
  {
   "tr": "Ameliyat kısa sürdü ve ondan sonra bir hafta hastanede kaldı."
  },
  {
   "tr": "Arkadaşları ona kartlar ve komik mesajlar gönderdi."
  },
  {
   "tr": "Kız kardeşi ona kitaplar ve en sevdiği çikolatayı getirdi."
  },
  {
   "tr": "Eve döndüğünde kendini çok daha iyi hissediyordu."
  },
  {
   "tr": "Yine kendi yatağında uyuyacağı için mutluydu."
  }
 ],
