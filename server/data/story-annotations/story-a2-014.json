{
 "storyId": "story-a2-014",
 "textHash": "6611fc947cfe",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yaz Emma ve arkadaşları bir gölün yakınında kampa gittiler."
  },
  {
   "tr": "İki çadır, sıcak tutan giysiler ve bir sürü yiyecek götürdüler."
  },
  {
   "tr": "İlk gün gölde yüzdüler ve ormanda yürüdüler."
  },
  {
   "tr": "Akşam ateş yaktılar ve sosis pişirdiler."
  },
  {
   "tr": "Gece şiddetli yağmur yağmaya başladı ve çadırlardan birine su girdi."
  },
  {
   "tr": "Kimse pek iyi uyumadı."
  },
  {
   "tr": "Ama ertesi sabah hava güneşliydi ve herkes o ıslak geceye güldü."
  }
 ],
