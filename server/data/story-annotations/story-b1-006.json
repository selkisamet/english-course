 "textHash": "e26fdf14f8bc",
 "source": "manual",
 "sentences": [
  {
   "tr": "Yeni daireme taşındığımda kimseyi tanımıyordum."
  },
  {
   "tr": "Bir gün komşum Bayan Wilson kapımı çaldı."
  },
  {
   "tr": "Bana ev yapımı bir elmalı turta getirdi."
  },
  {
   "tr": "Konuşmaya başladık ve ikimizin de bahçe işlerini sevdiğini fark ettik."
  },
  {
   "tr": "O zamandan beri iyi arkadaş olduk."
  },
  {
   "tr": "Ben yokken bitkilerimi sulamama yardım ediyor."
  },
  {
   "tr": "Güvenebileceğin komşuların olması çok güzel."
  }
 ],
