{
 "storyId": "story-a2-011",
 "textHash": "928ba9010ea0",
 "source": "manual",
 "sentences": [
  {
   "tr": "Dün Daniel geç uyandı çünkü çalar saati çalmadı."
  },
  {
   "tr": "Hızla giyindi ve kahvaltı yapmadan otobüs durağına koştu."
  },
  {
   "tr": "Vardığında otobüs çoktan kalkıyordu."
  },
  {
   "tr": "Kollarını salladı ama şoför onu görmedi."
  },
  {
   "tr": "Sonraki otobüs otuz dakika sonraydı, bu yüzden Daniel yürümeye karar verdi."
  },
  {
   "tr": "Uzun bir yoldu ve işe saat onda vardı."
  },
  {
   "tr": "Patronu kızgın değildi ama Daniel o akşam yeni bir çalar saat aldı."
  }
 ],
