{
 "storyId": "story-b1-023",
 "textHash": "5b4164e6f1e6",
 "source": "manual",
 "sentences": [
  {
   "tr": "Birkaç yıl önce apartmanımızın arkasında boş bir arazi parçası vardı."
  },
  {
   "tr": "Arazi çöple doluydu ve kimse orayı kullanmıyordu."
  },
  {
   "tr": "Sonra bir grup komşu orayı bir bahçeye dönüştürmeye karar verdi."
  },
  {
   "tr": "Alanı temizlediler, tahta kasalar yaptılar ve sebze ile çiçek diktiler."
  },
  {
   "tr": "Şimdi her yaştan insan orada birlikte çalışıyor."
  },
  {
   "tr": "Çocuklar yiyeceğin nasıl yetiştiğini öğreniyor, yaşlılar da temiz havanın tadını çıkarıyor."
  },
  {
   "tr": "Bahçe mahallemizdeki insanları birbirine daha da yaklaştırdı."
  }
 ],
