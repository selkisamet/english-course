{
 "storyId": "story-b2-027",
 "textHash": "219d14670237",
 "source": "manual",
 "sentences": [
  {
   "tr": "Birçok öğrenci gibi Jack de eskiden geç saatlere kadar telefonuna bakıp sonra derste odaklanmakta zorlanırdı."
  },
  {
   "tr": "Bir psikoloji projesi kapsamında bir ay boyunca katı kurallara uymayı kabul etti: saat ondan sonra ekran yok ve her gece aynı saatte yatmak."
  },
  {
   "tr": "İlk hafta şaşırtıcı derecede zordu, çünkü alışkanlıktan dolayı sürekli telefonuna uzanıyordu."
  },
  {
   "tr": "Ancak ayın sonunda daha hızlı uykuya dalıyordu ve notları açıkça yükselmişti."
  }
 ],
