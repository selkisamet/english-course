{
 "storyId": "story-a2-023",
 "textHash": "00e5130441f9",
 "source": "manual",
 "sentences": [
  {
   "tr": "Salı sabahı Ben pencereden dışarı baktı ve her şeyin bembeyaz olduğunu gördü."
  },
  {
   "tr": "Çok kar vardı ve okullar kapalıydı."
  },
  {
   "tr": "Ben kalın montunu, şapkasını ve eldivenlerini giydi ve kız kardeşiyle dışarı koştu."
  },
  {
   "tr": "Bahçede büyük bir kardan adam yaptılar ve ona eski bir atkı taktılar."
  },
  {
   "tr": "Sonra yan evdeki arkadaşlarıyla karda oynadılar."
  },
  {
   "tr": "Öğleden sonra anneleri herkese sıcak çikolata yaptı."
  }
 ],
