 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen cumartesi kasabamızda sabahtan akşama kadar elektrik yoktu."
  },
  {
   "tr": "İlk başta çocuklarım sıkıldı çünkü televizyon izleyemiyor ya da bilgisayarı kullanamıyorlardı."
  },
  {
   "tr": "Öğle yemeği de pişiremedik, bu yüzden ekmek, peynir ve meyve yedik."
  },
  {
   "tr": "Öğleden sonra birlikte kâğıt oyunları ve kutu oyunları oynadık."
  },
  {
   "tr": "Akşam mum yaktık ve hikayeler anlattık."
  },
  {
   "tr": "Işıklar geri geldiğinde oğlum, \"Bu, tatilin en güzel günüydü!\" dedi."
  }
 ],
