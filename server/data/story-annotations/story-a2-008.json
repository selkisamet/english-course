 "source": "manual",
 "sentences": [
  {
   "tr": "Dün akşam arkadaşlarımı yemeğe davet ettim."
  },
  {
   "tr": "Makarna yapmayı planladım."
  },
  {
   "tr": "Suyu kaynattım ve sebzeleri hazırladım."
  },
  {
   "tr": "Ama sosa çok fazla tuz kattım!"
  },
  {
   "tr": "Tadı berbattı."
  },
  {
   "tr": "Hemen yeni bir sos yaptım."
  },
  {
   "tr": "Neyse ki ikincisi çok lezzetliydi."
  },
  {
   "tr": "Arkadaşlarım yemeğe bayıldı ve işlerimiz, hobilerimiz hakkında harika bir sohbet ettik."
  }
 ],
