 "source": "manual",
 "sentences": [
  {
   "tr": "Cuma akşamı Leo ve arkadaşları yeni bir film izlemek için sinemaya gittiler."
  },
  {
   "tr": "Biletlerini internetten aldılar, bu yüzden uzun bir kuyrukta beklemeleri gerekmedi."
  },
  {
   "tr": "Film başlamadan önce biraz patlamış mısır ve soğuk içecek aldılar."
  },
  {
   "tr": "Film, uzaya yolculuk eden bir grup çocuk hakkındaydı."
  },
  {
   "tr": "Heyecanlı ve komikti, herkes çok beğendi."
  },
  {
   "tr": "Filmden sonra bir kafeye gittiler ve en sevdikleri sahneler hakkında konuştular."
  }
 ],
