{
 "storyId": "story-b1-017",
 "textHash": "1c06ac56af8b",
 "source": "manual",
 "sentences": [
  {
   "tr": "Peter kırklı yaşlarında ama hiç yüzmeyi öğrenmedi."
  },
  {
   "tr": "Çocukken sudan korkardı ve yüzme derslerinden kaçmak için hep bir sebep bulurdu."
  },
  {
   "tr": "Geçen yıl kızı onunla birlikte plaja gelmesini istedi ve Peter utandı."
  },
  {
   "tr": "Bu yüzden yerel havuzda ders almaya karar verdi."
  },
  {
   "tr": "İlk birkaç hafta zordu ama öğretmeni çok sabırlıydı."
  },
  {
   "tr": "Şimdi durmadan elli metre yüzebiliyor."
  }
 ],
