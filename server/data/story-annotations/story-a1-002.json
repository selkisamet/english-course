{
 "storyId": "story-a1-002",
 "textHash": "296a3d70dda5",
 "source": "manual",
 "sentences": [
  {
   "tr": "Whiskers adında bir kedim var."
  },
  {
   "tr": "O çok şişman ve turuncu."
  },
  {
   "tr": "Whiskers bütün gün uyur."
  },
  {
   "tr": "Kanepede, yatakta ve yerde uyur."
  },
  {
   "tr": "Sadece yemek için uyanır."
  },
  {
   "tr": "Balığı ve sütü sever."
  },
  {
   "tr": "Okuldan eve döndüğümde bana bakar ve bir ses çıkarır."
  },
  {
   "tr": "Onunla on dakika oynarım ama sonra yine uyur."
  },
  {
   "tr": "Tembel ama çok sevimli."
  }
 ],
