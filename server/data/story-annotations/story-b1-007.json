{
 "storyId": "story-b1-007",
 "textHash": "2dcb7e8e18d9",
 "source": "manual",
 "sentences": [
  {
   "tr": "Liam geçen cumartesi yerel bir yemek yarışmasına katıldı."
  },
  {
   "tr": "Büyükannesinin gizli çorba tarifini yapmaya karar verdi."
  },
  {
   "tr": "Beş başka aşçıyla yarışıyordu."
  },
  {
   "tr": "Yarışma sırasında elini hafifçe yaktı ama yemek yapmaya devam etti."
  },
  {
   "tr": "Jüri üyeleri çorbasının tadına baktı ve ona bayıldı."
  },
  {
   "tr": "Birincilik ödülünü kazanamasa da yaratıcılık dalında özel bir ödül aldı."
  },
  {
   "tr": "Başarısıyla çok gurur duydu."
  }
 ],
