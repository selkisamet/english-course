 "source": "manual",
 "sentences": [
  {
   "tr": "Ofisimin yakınında küçük bir kafe var."
  },
  {
   "tr": "Adı \"The Bean\"."
  },
  {
   "tr": "Her sabah oraya giderim."
  },
  {
   "tr": "Mekân taze kahve kokar."
  },
  {
   "tr": "Beş masa ve rahat sandalyeler var."
  },
  {
   "tr": "Sahibi Bay Brown adında yaşlı bir adam."
  },
  {
   "tr": "Adımı biliyor."
  },
  {
   "tr": "Her zaman bir kapuçino isterim."
  },
  {
   "tr": "Pencerenin yanına oturup dışarıdaki insanlara bakarım."
  },
  {
   "tr": "Sessiz ve güzel bir yer."
  }
 ],
