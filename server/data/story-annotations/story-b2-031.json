{
 "storyId": "story-b2-031",
 "textHash": "5e3261a685c6",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kendi restoranının karşısına yeni bir restoran açılınca Marco, onun birdenbire internette yüzlerce mükemmel yoruma sahip olduğunu fark etti."
  },
  {
   "tr": "Bunların çoğu aynı gün yazılmıştı ve neredeyse birbirinin aynısı ifadeler kullanıyordu."
  },
  {
   "tr": "Sahte olduklarından şüphelenerek onları web sitesine bildirdi."
  },
  {
   "tr": "Yapılan incelemenin ardından yorumlar kaldırıldı ve restorana uyarı verildi."
  },
  {
   "tr": "Bu deneyim Marco'ya internetteki puanlara her zaman güvenilmemesi gerektiğini öğretti."
  }
 ],
