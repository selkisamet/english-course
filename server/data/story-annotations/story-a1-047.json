 "source": "manual",
 "sentences": [
  {
   "tr": "Sıcak bir yaz gecesi."
  },
  {
   "tr": "Leo ve büyükbabası bahçedeler."
  },
  {
   "tr": "Çimenlere oturup yukarı bakıyorlar."
  },
  {
   "tr": "Hava karanlık ve yüzlerce yıldız var."
  },
  {
   "tr": "Ay büyük ve beyaz."
  },
  {
   "tr": "Büyükbabası birçok yıldızın adını biliyor."
  },
  {
   "tr": "Leo'ya en parlak yıldızı gösteriyor."
  },
  {
   "tr": "Leo geceyi çok güzel buluyor ve yatmak istemiyor."
  }
 ],
