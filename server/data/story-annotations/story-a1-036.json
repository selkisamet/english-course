 "source": "manual",
 "sentences": [
  {
   "tr": "Adım Sofia ve öğrenciyim."
  },
  {
   "tr": "Hafta sonları küçük bir kafede çalışıyorum."
  },
  {
   "tr": "Sabah saat sekizde işe başlıyorum."
  },
  {
   "tr": "Kahve ve çay yapıyorum, masalara yemek taşıyorum."
  },
  {
   "tr": "Bazı müşteriler çok cana yakın."
  },
  {
   "tr": "Benimle sohbet edip teşekkür ediyorlar."
  },
  {
   "tr": "İş kolay değil ama seviyorum."
  },
  {
   "tr": "Yeni bir bilgisayar için para biriktiriyorum."
  }
 ],
