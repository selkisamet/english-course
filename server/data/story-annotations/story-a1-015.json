 "source": "manual",
 "sentences": [
  {
   "tr": "Lucy her sabah okul otobüsüne biner."
  },
  {
   "tr": "Otobüs yedi buçukta evinin önünde durur."
  },
  {
   "tr": "Şoför, Bay Jones adında güler yüzlü bir adamdır."
  },
  {
   "tr": "Her zaman \"Günaydın!\" der."
  },
  {
   "tr": "Lucy arkadaşı Mia'nın yanına oturur."
  },
  {
   "tr": "Okul yolunda konuşup gülerler."
  },
  {
   "tr": "Yolculuk yirmi dakika sürer."
  },
  {
   "tr": "Öğleden sonra aynı otobüs onları eve getirir."
  }
 ],
