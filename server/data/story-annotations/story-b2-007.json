 "source": "manual",
 "sentences": [
  {
   "tr": "Şirket, plastik atığı azaltmayı amaçlayan yeni bir proje başlattı."
  },
  {
   "tr": "Proje yöneticisi olarak projenin başarısından David sorumlu."
  },
  {
   "tr": "Bütün teslim tarihlerine uyulsun diye bir süredir fazla mesai yapıyor."
  },
  {
   "tr": "Bütçe kısıtlı olsa da ekibin motivasyonu çok yüksek."
  },
  {
   "tr": "Başarırlarsa sektörde devrim yaratacak."
  },
  {
   "tr": "David, sıkı çalışmalarının başarıyla sonuçlanacağı konusunda iyimser."
  }
 ],
