 "textHash": "253a8686a6fd",
 "source": "manual",
 "sentences": [
  {
   "tr": "Nina her perşembe okuldan sonra kütüphaneye gider."
  },
  {
   "tr": "Kütüphane sessizdir ve binlerce kitap vardır."
  },
  {
   "tr": "Nina hayvanlarla ilgili hikâyelere bayılır."
  },
  {
   "tr": "Her hafta iki üç kitap seçer."
  },
  {
   "tr": "Kütüphaneci nazik bir kadındır."
  },
  {
   "tr": "Nina'nın güzel kitaplar bulmasına yardım eder."
  },
  {
   "tr": "Nina pencerenin yanındaki bir masaya oturur ve bir saat kitap okur."
  },
  {
   "tr": "Sonra kitapları eve götürür."
  }
 ],
