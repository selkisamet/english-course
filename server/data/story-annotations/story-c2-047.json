{
 "storyId": "story-c2-047",
 "textHash": "676491a4640a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kuzeye doğru uzun bir yolculukta Clara, kendini şiir kitabı okuyan yaşlı bir yabancıyla aynı masayı paylaşırken buldu."
  },
  {
   "tr": "Konuşmaya başladılar; ilk başta çekinerek, sonra şaşırtıcı bir içtenlikle."
  },
  {
   "tr": "Tren varana kadar Clara, kimseye anlatmadığı kuşkularını ona açmış, adam da onu bıraktığı mesleğin peşinden gitmeye teşvik etmişti."
  },
  {
   "tr": "Birbirlerine adlarını hiç söylemediler."
  },
  {
   "tr": "Yıllar sonra Clara hâlâ, o sohbetin hayatını ne kadar değiştirdiğini adamın bilip bilmediğini merak ediyor."
  }
 ],
