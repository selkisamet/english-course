{
 "storyId": "story-a2-039",
 "textHash": "be3597280e86",
 "source": "manual",
 "sentences": [
  {
   "tr": "Jake on beş yaşında ve oyunları için gerçekten yeni bir bilgisayar istiyor."
  },
  {
   "tr": "Bilgisayar altı yüz sterlin ama Jake'in yalnızca elli sterlini var."
  },
  {
   "tr": "Anne babası, geri kalanını biriktirirse yarısını ödeyeceklerini söyledi."
  },
  {
   "tr": "Bunun üzerine Jake bir plan yaptı."
  },
  {
   "tr": "Her gün komşusunun köpeğini gezdirmeye ve hafta sonları araba yıkamaya başladı."
  },
  {
   "tr": "Okuldan sonra şeker ve içecek almayı da bıraktı."
  },
  {
   "tr": "Sekiz ay sonra yeterli parası oldu."
  },
  {
   "tr": "Sonunda bilgisayarını aldığında Jake çok mutluydu."
  }
 ],
