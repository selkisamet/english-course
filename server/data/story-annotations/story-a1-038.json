 "source": "manual",
 "sentences": [
  {
   "tr": "Pazar sabahı Paul ve karısı nehir kenarında yürüyor."
  },
  {
   "tr": "Hava ılık ve güneşli."
  },
  {
   "tr": "Suyun üstünde ördekler var ve bazı çocuklar onlara ekmek veriyor."
  },
  {
   "tr": "Paul ve karısı bir saat yürüyor."
  },
  {
   "tr": "Sonra küçük bir kafede mola veriyorlar."
  },
  {
   "tr": "Kahve içip birer dilim pasta yiyorlar."
  },
  {
   "tr": "Güneşte oturup nehirdeki tekneleri izliyorlar."
  }
