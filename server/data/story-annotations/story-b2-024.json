 "source": "manual",
 "sentences": [
  {
   "tr": "Sofia bir hayvan barınağından köpek sahiplendiğinde, köpeğin zor olabileceği konusunda uyarıldı."
  },
  {
   "tr": "Max önceki sahibi tarafından kötü muamele görmüştü ve neredeyse her şeyden, özellikle yüksek seslerden korkuyordu."
  },
  {
   "tr": "İlk birkaç hafta boyunca, biri ziyarete geldiğinde yatağın altına saklandı."
  },
  {
   "tr": "Sofia sabırlı olmayı sürdürdü ve Max her cesaret gösterdiğinde onu bisküviyle ödüllendirdi."
  },
  {
   "tr": "Bir yıl sonra Max, kapıda her misafiri mutlulukla karşılayan bambaşka bir köpek."
  }
 ],
