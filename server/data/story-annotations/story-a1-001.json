 "source": "manual",
 "sentences": [
  {
   "tr": "Benim adım John."
  },
  {
   "tr": "Yirmi beş yaşındayım."
  },
  {
   "tr": "Chicago'da küçük bir evde yaşıyorum."
  },
  {
   "tr": "Kalabalık bir ailem var."
  },
  {
   "tr": "Babam yerel bir hastanede doktor."
  },
  {
   "tr": "Annem öğretmen."
  },
  {
   "tr": "Çocukları çok sever."
  },
  {
   "tr": "İki kız kardeşim ve bir erkek kardeşim var."
  },
  {
   "tr": "Her akşam birlikte akşam yemeği yeriz."
  },
  {
   "tr": "Kız kardeşlerim müzikten hoşlanır, erkek kardeşim de futbol oynar."
  },
  {
   "tr": "Ailemi seviyorum çünkü onlar nazik ve eğlenceliler."
  }
 ],
