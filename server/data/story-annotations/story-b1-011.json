{
 "storyId": "story-b1-011",
 "textHash": "748ebf3fc568",
 "source": "manual",
 "sentences": [
  {
   "tr": "Hannah geçen ilkbahardan beri haftada üç gün evden çalışıyor."
  },
  {
   "tr": "İlk başta buna bayıldı çünkü ofise gitmek zorunda değildi."
  },
  {
   "tr": "İşe rahat kıyafetlerle başlayabiliyor ve ulaşımdan para biriktirebiliyordu."
  },
  {
   "tr": "Ancak birkaç ay sonra kendini yalnız hissetmeye başladı."
  },
  {
   "tr": "İş arkadaşlarıyla sohbet etmeyi özledi."
  },
  {
   "tr": "Artık cuma günleri evinin yakınındaki bir kafeye gidiyor."
  },
  {
   "tr": "Orada çalışmak odaklanmasına yardımcı oluyor ve kendini o kadar yalnız hissetmiyor."
  }
 ],
