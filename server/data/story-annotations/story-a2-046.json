{
 "storyId": "story-a2-046",
 "textHash": "1e59b2680566",
 "source": "manual",
 "sentences": [
  {
   "tr": "Pazar akşamı Mia, pazartesi için matematik ödevi olduğunu hatırladı."
  },
  {
   "tr": "Saat çoktan dokuz olmuştu ve ödev çok zordu."
  },
  {
   "tr": "Bir saat uğraştı ama son üç soruyu cevaplayamadı."
  },
  {
   "tr": "Endişelendi ve neredeyse ağlıyordu."
  },
  {
   "tr": "Sonra arkadaşı Ella'yı aradı."
  },
  {
   "tr": "Ella soruları telefonda yavaşça açıkladı ve Mia sonunda onları anladı."
  },
  {
   "tr": "Saat on buçukta bitirdi."
  },
  {
   "tr": "Ertesi gün öğretmeni ödevinin mükemmel olduğunu söyledi."
  }
 ],
