 "source": "manual",
 "sentences": [
  {
   "tr": "Yaz boyunca her cuma kasabamızın ana meydanı bir gece pazarına dönüşüyor."
  },
  {
   "tr": "Onlarca tezgâhta sokak yemekleri, el yapımı takılar ve ikinci el kıyafetler satılıyor."
  },
  {
   "tr": "Yerel müzisyenler küçük bir sahnede çalıyor ve ortam gece yarısından epey sonrasına kadar canlı kalıyor."
  },
  {
   "tr": "Pazar başlangıçta turistleri çekmek için başlatılmıştı ama kasaba halkı arasında da en az o kadar popüler oldu."
  },
  {
   "tr": "Orada başlayan bazı küçük işletmelerin artık kasaba merkezinde kendi dükkânları var."
  }
 ],
