{
 "storyId": "story-a1-027",
 "textHash": "715debc7bf2c",
 "source": "manual",
 "sentences": [
  {
   "tr": "Lily altı yaşında."
  },
  {
   "tr": "Bugün bisiklet sürmeyi öğreniyor."
  },
  {
   "tr": "Babası bisikletin arkasını tutuyor ve Lily hareket etmeye başlıyor."
  },
  {
   "tr": "Babası \"Durma!\" diyor."
  },
  {
   "tr": "Lily sokakta yavaşça ilerliyor."
  },
  {
   "tr": "Babası bisikleti bırakıyor ama Lily bunu bilmiyor."
  },
  {
   "tr": "İlk kez tek başına sürüyor!"
  },
  {
   "tr": "Kendisiyle çok gurur duyuyor."
  }
 ],
