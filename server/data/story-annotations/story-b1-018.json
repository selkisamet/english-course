{
 "storyId": "story-b1-018",
 "textHash": "f4f4deb7d9a7",
 "source": "manual",
 "sentences": [
  {
   "tr": "Her akşam yaşlı bir adam ana tren istasyonunun önünde keman çalar."
  },
  {
   "tr": "İnsanların çoğu yanından aceleyle geçer ama birkaçı durup dinler."
  },
  {
   "tr": "Geçen hafta genç bir kadın orada uzun süre durdu."
  },
  {
   "tr": "Adam çalmayı bitirince kadın ona müzik öğretmeni olduğunu söyledi."
  },
  {
   "tr": "Onu okulundaki bir konserde çalmaya davet etti."
  },
  {
   "tr": "Adam o kadar mutlu oldu ki neredeyse konuşamadı."
  },
  {
   "tr": "Geçen cuma iki yüz çocuk onun çalışını dinledi."
  }
 ],
