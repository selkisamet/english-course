 "source": "manual",
 "sentences": [
  {
   "tr": "Lewis gençken sık sık polisle başı derde girerdi ve okulu hiçbir diploma almadan bıraktı."
  },
  {
   "tr": "Yıllar sonra birçok fırsatı boşa harcadığını fark etti."
  },
  {
   "tr": "Otuz yaşında, eğitimini tamamlamak için bir akşam kursuna katıldı."
  },
  {
   "tr": "Bir fabrikada çalışırken ders çalışmak kolay değildi ama pes etmek istediği her an öğretmenleri onu cesaretlendirdi."
  },
  {
   "tr": "Sonunda bütün sınavlarını geçti ve şimdi bir zamanlar kendisinin yaşadığı sorunlarla karşılaşan gençlerle çalışmak için eğitim alıyor."
  }
 ],
