{
 "storyId": "story-a1-032",
 "textHash": "c6be979f8f4e",
 "source": "manual",
 "sentences": [
  {
   "tr": "Cumartesi öğleden sonra."
  },
  {
   "tr": "Daniel ve babası büyük bir futbol maçındalar."
  },
  {
   "tr": "En sevdikleri takım bugün oynuyor."
  },
  {
   "tr": "Binlerce insan var ve herkes kırmızı tişört giyiyor."
  },
  {
   "tr": "Oyuncular sahaya koşarak çıkıyor ve insanlar şarkı söylüyor."
  },
  {
   "tr": "Yirmi dakika sonra takımları ilk golü atıyor!"
  },
  {
   "tr": "Daniel ve babası ayağa kalkıp şarkı söylüyor."
  },
  {
   "tr": "Sonunda takımları ikiye bir kazanıyor."
  },
  {
   "tr": "Eve çok mutlu dönüyorlar."
  }
 ],
