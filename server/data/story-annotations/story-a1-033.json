{
 "storyId": "story-a1-033",
 "textHash": "f6126990d20d",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ella bugün bir mektup alıyor."
  },
  {
   "tr": "Mektup büyükbabasından."
  },
  {
   "tr": "Büyükbabası uzakta, küçük bir kasabada yaşıyor."
  },
  {
   "tr": "Mektupta bahçesinden ve yaşlı köpeğinden söz ediyor."
  },
  {
   "tr": "Ella'nın okulunu da soruyor."
  },
  {
   "tr": "Sonunda şöyle yazıyor: \"Seni özledim."
  },
  {
   "tr": "Lütfen yazın beni ziyarete gel.\""
  },
  {
   "tr": "Ella gülümsüyor."
  },
  {
   "tr": "Bir kalem ve biraz kâğıt alıp cevabını yazmaya başlıyor."
  }
 ],
