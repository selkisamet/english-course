{
 "storyId": "story-b1-021",
 "textHash": "b2a6018beacd",
 "source": "manual",
 "sentences": [
  {
   "tr": "Aynı şirkette beş yıl çalıştıktan sonra Laura'ya sonunda terfi teklif edildi."
  },
  {
   "tr": "Müdürü ondan sekiz kişilik bir ekibi yönetmesini istedi."
  },
  {
   "tr": "Heyecan verici bir haberdi ama Laura aynı zamanda endişeliydi."
  },
  {
   "tr": "Daha önce hiç yönetici olmamıştı ve bazı iş arkadaşları ondan büyüktü."
  },
  {
   "tr": "Yeni yöneticiler için kısa bir kursa katılmaya karar verdi."
  },
  {
   "tr": "Şimdi, altı ay sonra, ekibi iyi bir uyum içinde çalışıyor ve Laura yeni görevinde kendine çok daha fazla güveniyor."
  }
 ],
