{
 "storyId": "story-a2-026",
 "textHash": "f8d19e9200e5",
 "source": "manual",
 "sentences": [
  {
   "tr": "Anna her yaz deniz kenarındaki küçük bir köyde yaşayan büyükannesiyle büyükbabasını ziyaret eder."
  },
  {
   "tr": "Evleri eski ama çok rahat."
  },
  {
   "tr": "Büyükannesi bahçede sebze yetiştirir ve Anna ona her sabah yardım eder."
  },
  {
   "tr": "Öğleden sonraları denizde yüzerler ya da kumsal boyunca yürürler."
  },
  {
   "tr": "Akşamları büyükbabası gençliğine dair komik hikayeler anlatır."
  },
  {
   "tr": "Tatil bittiğinde Anna her zaman üzülür."
  },
  {
   "tr": "Şimdiden gelecek yaza kadar günleri sayıyor."
  }
 ],
