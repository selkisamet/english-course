 "source": "manual",
 "sentences": [
  {
   "tr": "Tom yılbaşından beri kilo vermeye karar vermiş durumda."
  },
  {
   "tr": "Sağlıksız yiyecekleri ve şekeri yemeyi bıraktı."
  },
  {
   "tr": "Çikolatayı çok sevdiği için bu kolay olmadı."
  },
  {
   "tr": "Yine de şimdiden beş kilo verdi."
  },
  {
   "tr": "Haftada üç kez koşuya gidiyor."
  },
  {
   "tr": "Bu düzene devam ederse yaza kadar çok daha sağlıklı olacak."
  },
  {
   "tr": "Kendini eskisinden daha enerjik hissediyor."
  }
 ],
