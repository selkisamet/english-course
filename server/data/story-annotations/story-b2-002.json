 "source": "manual",
 "sentences": [
  {
   "tr": "Bir yazılım mühendisi olan James, akıllı telefonuna bağımlı olduğunu fark etti."
  },
  {
   "tr": "Kendini bitkin ve tükenmiş hissediyordu."
  },
  {
   "tr": "Sonuç olarak bir haftalığına dijital detoks denemeye karar verdi."
  },
  {
   "tr": "İlk birkaç gün zorluydu ama dördüncü güne gelindiğinde çevresindeki dünyanın güzelliğini takdir etmeye başladı."
  },
  {
   "tr": "Kitap okudu ve resim yaptı."
  },
  {
   "tr": "Teknolojinin hayatını kontrol etmemesi gerektiğini anladı."
  }
 ],
