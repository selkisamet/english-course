 "source": "manual",
 "sentences": [
  {
   "tr": "Cumartesi günü Bay Smith arabayla kırsala gitmek istedi."
  },
  {
   "tr": "Arabasına bindi ama motor çalışmadı."
  },
  {
   "tr": "Kaputun altına baktı ama nasıl tamir edeceğini bilmiyordu."
  },
  {
   "tr": "Bir tamirci çağırdı."
  },
  {
   "tr": "Tamirci bir saat sonra geldi ve sorunu hızla giderdi."
  },
  {
   "tr": "Sadece akü bitmişti."
  },
  {
   "tr": "Bay Smith geç kaldı ama yine de gününün tadını çıkardı."
  }
 ],
