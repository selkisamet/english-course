 "source": "manual",
 "sentences": [
  {
   "tr": "İki yıl önce Helen mahalledeki kütüphanede bir kitap kulübüne katıldı."
  },
  {
   "tr": "Üyeler, hepsinin okuduğu bir kitabı tartışmak için her ayın ilk pazartesisi buluşuyor."
  },
  {
   "tr": "Helen aynı hikaye hakkında farklı görüşler duymaktan keyif alıyor."
  },
  {
   "tr": "Kulüp sayesinde bilim kurgu ve tarih gibi, normalde seçmeyeceği kitaplar okudu."
  },
  {
   "tr": "Orada birkaç iyi arkadaş da edindi."
  },
  {
   "tr": "Gelecek ay kitabı seçme sırası onda."
  }
 ],
