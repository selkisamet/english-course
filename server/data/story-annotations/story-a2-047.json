{
 "storyId": "story-a2-047",
 "textHash": "31f7dc131594",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bay Brown bizim evin yanındaki evde tek başına yaşıyor."
  },
  {
   "tr": "Seksen yaşında ve geçen ay bacağını kırdı."
  },
  {
   "tr": "Alışverişe gidemiyor, köpeğini de gezdiremiyordu."
  },
  {
   "tr": "Bu yüzden erkek kardeşimle ben ona yardım etmeye karar verdik."
  },
  {
   "tr": "Her öğleden sonra okuldan sonra köpeğini parka götürdük."
  },
  {
   "tr": "Cumartesileri onun alışverişini süpermarketten biz yaptık."
  },
  {
   "tr": "Bay Brown bize her zaman çay ve bisküvi verir, hayatıyla ilgili hikayeler anlatırdı."
  },
  {
   "tr": "Şimdi bacağı daha iyi ama onu hâlâ her hafta ziyaret ediyoruz."
  }
 ],
