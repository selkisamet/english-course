 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün pazartesi."
  },
  {
   "tr": "Yeni bir İngilizce öğretmenimiz var."
  },
  {
   "tr": "Onun adı Bayan Green."
  },
  {
   "tr": "Uzun boylu ve kahverengi saçlı."
  },
  {
   "tr": "Londralı."
  },
  {
   "tr": "Çok anlaşılır konuşuyor."
  },
  {
   "tr": "Sınıfta yeni kelimeleri tahtaya yazıyor."
  },
  {
   "tr": "Bir kitap okuyup basit cümleler yazıyoruz."
  },
  {
   "tr": "Bayan Green çok cana yakın ve yardımsever."
  },
  {
   "tr": "Çok gülümsüyor."
  },
  {
   "tr": "Onun derslerini seviyorum çünkü birçok şey öğreniyorum."
  }
 ],
