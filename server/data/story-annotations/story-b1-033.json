{
 "storyId": "story-b1-033",
 "textHash": "e2b7f096dbc8",
 "source": "manual",
 "sentences": [
  {
   "tr": "Carla iki yıldır Londra'da yaşıyordu ki İspanya'daki anne babasına sürpriz yapmaya karar verdi."
  },
  {
   "tr": "Erkek kardeşi dışında kimseye söylemedi."
  },
  {
   "tr": "Bir bilet aldı ve bir cuma akşamı uçakla eve gitti."
  },
  {
   "tr": "Zili çaldığında annesi kapıyı açtı ve sevinçten çığlık attı."
  },
  {
   "tr": "Babası o kadar şaşırdı ki elindeki kahve fincanını düşürdü."
  },
  {
   "tr": "Bütün hafta sonunu birlikte yemek yaparak, konuşarak ve gülerek geçirdiler."
  },
  {
   "tr": "Carla'nın yıllardır geçirdiği en güzel hafta sonuydu."
  }
 ],
