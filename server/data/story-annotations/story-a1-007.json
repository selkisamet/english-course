 "source": "manual",
 "sentences": [
  {
   "tr": "Her cumartesi babamla markete giderim."
  },
  {
   "tr": "Dükkân çok büyük."
  },
  {
   "tr": "Alınacak çok şey var."
  },
  {
   "tr": "Önce meyve bölümüne gideriz."
  },
  {
   "tr": "Elma, muz ve portakal alırız."
  },
  {
   "tr": "Sonra fırına gideriz."
  },
  {
   "tr": "Ekmek taze ve güzel kokuyor."
  },
  {
   "tr": "Babam süt ve yumurta alır."
  },
  {
   "tr": "Ben biraz çikolata seçerim."
  },
  {
   "tr": "Yiyeceklerin parasını öder ve arabamızla eve gideriz."
  }
