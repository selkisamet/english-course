{
 "storyId": "story-b2-039",
 "textHash": "ff8eff7d8535",
 "source": "manual",
 "sentences": [
  {
   "tr": "Yakın zamana kadar Nadia'nın büyüdüğü küçük dağ köyünde güvenilir bir internet bağlantısı yoktu."
  },
  {
   "tr": "Gençler iş bulmak için şehirlere gidiyordu ve nüfus her yıl azalıyordu."
  },
  {
   "tr": "İki yıl önce yerel yönetim sonunda hızlı internet kurdu."
  },
  {
   "tr": "O zamandan beri birkaç aile evden çalışmak için oraya taşındı ve küçük bir teknoloji şirketi bir ofis açtı."
  },
  {
   "tr": "Kapanma tehlikesiyle karşı karşıya olan köy okulunun şimdi son on yıllardaki en yüksek öğrenci sayısı var."
  }
 ],
