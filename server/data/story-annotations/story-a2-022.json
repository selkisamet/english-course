{
 "storyId": "story-a2-022",
 "textHash": "929c09269c4a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Maria'nın erkek kardeşi Avustralya'da yaşıyor ve Maria onu üç yıldır görmedi."
  },
  {
   "tr": "Dün kardeşi bir ziyaret için uçakla eve geldi."
  },
  {
   "tr": "Maria havaalanına iki saat erken gitti çünkü çok heyecanlıydı."
  },
  {
   "tr": "Çıkışın yakınında, üzerinde kardeşinin adı yazan büyük bir tabelayla bekledi."
  },
  {
   "tr": "Uçak kırk dakika rötar yaptı ve Maria her dakika daha da gerildi."
  },
  {
   "tr": "Sonunda onun kapılardan geçtiğini gördü."
  },
  {
   "tr": "Uzun süre sarıldılar ve ikisi de biraz ağladı."
  }
 ],
