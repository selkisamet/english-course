 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen hafta sonu odamı temizlerken bir kutunun içinde eski bir fotoğraf buldum."
  },
  {
   "tr": "Fotoğrafta uzun, koyu renk saçlı genç bir kadın vardı."
  },
  {
   "tr": "Bir bisikletin yanında duruyor ve gülümsüyordu."
  },
  {
   "tr": "Kim olduğunu bilmiyordum, bu yüzden fotoğrafı babama gösterdim."
  },
  {
   "tr": "Babam güldü ve \"Bu senin büyükannen."
  },
  {
   "tr": "O zaman yirmi yaşındaydı.\" dedi."
  },
  {
   "tr": "Çok şaşırdım."
  },
  {
   "tr": "Şimdi fotoğraf oturma odamızın duvarında asılı."
  }
 ],
