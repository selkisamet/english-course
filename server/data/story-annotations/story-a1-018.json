 "source": "manual",
 "sentences": [
  {
   "tr": "Yatak odam küçük ama onu çok seviyorum."
  },
  {
   "tr": "Duvarlar açık mavi."
  },
  {
   "tr": "Pencerenin yanında bir yatak var."
  },
  {
   "tr": "Yatağın yakınında bir çalışma masası ve bir sandalye var."
  },
  {
   "tr": "Ödevimi masada yaparım."
  },
  {
   "tr": "Duvarda ailemin ve arkadaşlarımın fotoğrafları var."
  },
  {
   "tr": "Bir rafta bir sürü kitabım var."
  },
  {
   "tr": "Geceleri uyumadan önce kitap okurum."
  }
