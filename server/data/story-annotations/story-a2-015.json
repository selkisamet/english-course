{
 "storyId": "story-a2-015",
 "textHash": "38450ec04dfc",
 "source": "manual",
 "sentences": [
  {
   "tr": "On yedi yaşındayken küçük bir restoranda ilk işimi buldum."
  },
  {
   "tr": "Orada her cumartesi ve pazar çalıştım."
  },
  {
   "tr": "İşim bulaşıkları yıkamak ve masaları temizlemekti."
  },
  {
   "tr": "İş zordu ve günün sonunda her zaman yorgundum."
  },
  {
   "tr": "Ama aşçı çok iyi kalpliydi ve bana çorba ile salata yapmayı öğretti."
  },
  {
   "tr": "Biraz para kazandım ve çoğunu yeni bir bisiklet için biriktirdim."
  },
  {
   "tr": "O işi hâlâ gülümseyerek hatırlıyorum."
  }
 ],
