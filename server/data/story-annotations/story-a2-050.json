{
 "storyId": "story-a2-050",
 "textHash": "f8f2cce15dde",
 "source": "manual",
 "sentences": [
  {
   "tr": "Her ağustosta büyükannemle büyükbabamın yaşadığı köyde büyük bir festival olur."
  },
  {
   "tr": "Köyün yakınındaki bütün kasabalardan insanlar gelir."
  },
  {
   "tr": "Gündüz çocuklar için oyunlar olur, çiftçiler de peynir, bal ve meyve satar."
  },
  {
   "tr": "Akşam herkes ana meydandaki uzun masalarda birlikte yemek yer."
  },
  {
   "tr": "Akşam yemeğinden sonra müzisyenler geleneksel şarkılar çalar ve insanlar dans eder."
  },
  {
   "tr": "Bu yıl kuzenlerimle ben festivalde kek sattık."
  },
  {
   "tr": "Elliden fazla kek sattık ve parayı köy okuluna bağışladık."
  }
 ],
