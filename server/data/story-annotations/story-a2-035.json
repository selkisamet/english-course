{
 "storyId": "story-a2-035",
 "textHash": "a0e95f61a854",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yıl arkadaşım Kate haftada üç kez koşmaya başladı."
  },
  {
   "tr": "Nisanda şehrimizdeki on kilometrelik bir yarışa katılmaya karar verdi."
  },
  {
   "tr": "İki ay boyunca sıkı antrenman yaptı ve sağlıklı beslendi."
  },
  {
   "tr": "Yarış günü hava sıcaktı ve binden fazla koşucu vardı."
  },
  {
   "tr": "Yedi kilometreden sonra Kate çok yorgundu ama durmadı."
  },
  {
   "tr": "Yarışı bir saatten kısa sürede bitirdi."
  },
  {
   "tr": "Kendisiyle çok gurur duydu ve şimdi daha uzun bir yarışta koşmak istiyor."
  }
 ],
