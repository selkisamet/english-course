{
 "storyId": "story-a2-029",
 "textHash": "8656004cc6a0",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bu yaz ailem iki haftalığına İspanya'ya gidecek."
  },
  {
   "tr": "Uçakla Barselona'ya gideceğiz ve plajın yakınındaki bir otelde kalacağız."
  },
  {
   "tr": "Annem müzeleri ve eski kiliseleri gezmek istiyor."
  },
  {
   "tr": "Babam bir sürü İspanyol yemeği deneyecek."
  },
  {
   "tr": "Küçük kız kardeşim ise sadece her gün denizde yüzmek istiyor."
  },
  {
   "tr": "Ben de yeni fotoğraf makinemle bir sürü fotoğraf çekeceğim."
  },
  {
   "tr": "Hepimiz bu gezi için çok heyecanlıyız."
  }
 ],
