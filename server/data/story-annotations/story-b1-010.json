 "source": "manual",
 "sentences": [
  {
   "tr": "Maria haftalardır final biyoloji sınavına çalışıyor."
  },
  {
   "tr": "Ders kitabını iki kez okudu ve birçok tekrar kartı hazırladı."
  },
  {
   "tr": "Yorgun ve stresli hissediyor."
  },
  {
   "tr": "Annesi ona ara verip uyumasını tavsiye etti."
  },
  {
   "tr": "Maria annesinin haklı olduğunu biliyor."
  },
  {
   "tr": "Uyumazsa yarın odaklanamayacak."
  },
  {
   "tr": "Bu akşam rahatlamak için film izlemeyi planlıyor."
  }
 ],
