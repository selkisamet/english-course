{
 "storyId": "story-b1-026",
 "textHash": "d40d4e174dae",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yıl Sara'ya başka bir şehirde iyi bir iş teklif edildi."
  },
  {
   "tr": "Maaş çok daha yüksekti ve iş kulağa ilginç geliyordu."
  },
  {
   "tr": "Ancak teklifi kabul etmek, ailesini ve arkadaşlarını bırakmak anlamına gelecekti."
  },
  {
   "tr": "Birkaç hafta boyunca ne yapacağına karar veremedi."
  },
  {
   "tr": "Avantajların ve dezavantajların bir listesini yaptı ve güvendiği insanlarla konuştu."
  },
  {
   "tr": "Sonunda işi kabul etti."
  },
  {
   "tr": "İlk başta zordu ama yeni arkadaşlar edindi ve her ay ailesini ziyaret ediyor."
  }
 ],
