{
 "storyId": "story-a1-011",
 "textHash": "c6424c36aaef",
 "source": "manual",
 "sentences": [
  {
   "tr": "En iyi arkadaşım Emma."
  },
  {
   "tr": "O da benim gibi on bir yaşında."
  },
  {
   "tr": "Okulda aynı sınıftayız."
  },
  {
   "tr": "Emma'nın uzun siyah saçları ve kahverengi gözleri var."
  },
  {
   "tr": "Çok komik ve naziktir."
  },
  {
   "tr": "Her gün okula birlikte yürürüz."
  },
  {
   "tr": "Okuldan sonra onun evinde ödevimizi yaparız."
  },
  {
   "tr": "Annesi bize sandviç yapar."
  },
  {
   "tr": "Cumartesileri parkta tenis oynarız."
  },
  {
   "tr": "Mutluyum çünkü iyi bir arkadaşım var."
  }
 ],
