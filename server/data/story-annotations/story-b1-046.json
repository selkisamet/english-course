{
 "storyId": "story-b1-046",
 "textHash": "cc24bc8f6da5",
 "source": "manual",
 "sentences": [
  {
   "tr": "Omar şehirde yeni bir iş bulduktan sonra hızla bir daire bulması gerekti."
  },
  {
   "tr": "Her gün internet sitelerine baktı ve iki haftada ondan fazla daire gezdi."
  },
  {
   "tr": "Bazıları çok pahalıydı, diğerleri de ofisine çok uzaktı."
  },
  {
   "tr": "Bir daire fotoğraflarda çok güzel görünüyordu ama gerçekte karanlık ve küçüktü."
  },
  {
   "tr": "Sonunda işine yalnızca on dakika uzaklıkta, balkonlu ve aydınlık bir daire buldu."
  },
  {
   "tr": "Sözleşmeyi aynı gün imzaladı."
  }
 ],
