{
 "storyId": "story-b2-030",
 "textHash": "048c94d70582",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen ocakta Clarke ailesi ergenlik çağındaki kızlarından gelen bir meydan okumayı kabul etti: bütün bir ay boyunca et yemeyeceklerdi."
  },
  {
   "tr": "Anne babası aç kalmayı ve en sevdikleri yemekleri özlemeyi bekliyordu."
  },
  {
   "tr": "Bunun yerine fasulye, pirinç ve sebzelerle yapılan çok çeşitli yeni tarifler keşfettiler."
  },
  {
   "tr": "Sonrasında tamamen vejetaryen olmasalar da artık haftada yalnızca iki kez et yiyorlar."
  },
  {
   "tr": "Kendilerini daha sağlıklı hissettiklerini ve meydan okumayı kabul ettikleri için memnun olduklarını söylüyorlar."
  }
 ],
