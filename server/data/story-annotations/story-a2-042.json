{
 "storyId": "story-a2-042",
 "textHash": "d54dabd1dac2",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kışın kuşların yiyecek bulması zordur."
  },
  {
   "tr": "Bu yüzden büyükannem her sabah bahçesindeki duvarın üstüne ekmek ve tohum koyar."
  },
  {
   "tr": "Kısa süre sonra bir sürü küçük kuş yemeye gelir."
  },
  {
   "tr": "Bazıları kahverengidir, bazılarının da kırmızı ya da sarı tüyleri vardır."
  },
  {
   "tr": "Büyükannem hepsinin adını bilir."
  },
  {
   "tr": "Geçen hafta sonu bana kuşlarla ilgili küçük bir kitap verdi."
  },
  {
   "tr": "Şimdi ben de kendi bahçemdeki kuşları besliyorum ve gördüklerimin adlarını not ediyorum."
  }
 ],
