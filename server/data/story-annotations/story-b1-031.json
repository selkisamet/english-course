{
 "storyId": "story-b1-031",
 "textHash": "0ac1a734a609",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen salı Emma telefonunu otobüsün zeminine düşürdü ve ekran kırıldı."
  },
  {
   "tr": "Telefonu hâlâ kullanabiliyordu ama mesajlarını okumak zordu."
  },
  {
   "tr": "Yeni bir telefon çok pahalıydı, bu yüzden bir tamirci aradı."
  },
  {
   "tr": "Dükkândaki adam ekranı bir saat içinde değiştirebileceğini söyledi."
  },
  {
   "tr": "Kırk sterlin tuttu; bu, beklediğinden çok daha ucuzdu."
  },
  {
   "tr": "O zamandan beri telefonunu sağlam bir kılıfta tutuyor."
  }
 ],
