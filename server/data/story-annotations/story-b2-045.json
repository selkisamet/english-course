{
 "storyId": "story-b2-045",
 "textHash": "5c9ea5fe6b85",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ucuz modanın çevreye etkisinden endişe duyan bir grup öğrenci, okullarında bir kıyafet takası düzenledi."
  },
  {
   "tr": "Katılımcılar yeni ürünler satın almak yerine artık giymedikleri kıyafetleri getirip farklı bir şeyle değiştirdi."
  },
  {
   "tr": "Etkinlik beklenenden çok daha fazla ilgi gördü ve iki yüzden fazla kişi katıldı."
  },
  {
   "tr": "Sonunda kalan kıyafetler yerel bir hayır kurumuna bağışlandı."
  },
  {
   "tr": "Düzenleyiciler artık takası yılda iki kez yapıyor ve başka okulların da onları örnek almasını umuyor."
  }
 ],
