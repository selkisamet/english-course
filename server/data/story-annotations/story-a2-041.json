{
 "storyId": "story-a2-041",
 "textHash": "cecdcb830aab",
 "source": "manual",
 "sentences": [
  {
   "tr": "Dün gece kasabamızda korkunç bir fırtına vardı."
  },
  {
   "tr": "Rüzgâr çok sertti ve saatlerce yağmur yağdı."
  },
  {
   "tr": "Gece yarısına doğru ışıklar söndü ve hiçbir şey göremiyorduk."
  },
  {
   "tr": "Babam bir çekmecede birkaç mum buldu ve oturma odasında birlikte oturduk."
  },
  {
   "tr": "Yüksek gök gürültüsünü duyduk ve gökyüzünde şimşekleri gördük."
  },
  {
   "tr": "Sabah fırtına dinmişti."
  },
  {
   "tr": "Evimizin yakınındaki büyük bir ağaç yere devrilmişti ama neyse ki kimse yaralanmadı."
  }
 ],
