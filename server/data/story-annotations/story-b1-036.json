{
 "storyId": "story-b1-036",
 "textHash": "71aeecc6e785",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bay Kim emekli olduktan sonra boş zamanını nasıl geçireceğini bilemedi."
  },
  {
   "tr": "Eşi resim yapmayı denemesini önerdi."
  },
  {
   "tr": "İlk başta emin değildi çünkü okuldan beri hiç resim yapmamıştı."
  },
  {
   "tr": "Yine de mahalledeki toplum merkezinde bir kursa katıldı."
  },
  {
   "tr": "Renkleri karıştırmayı ve manzara resmi yapmayı öğrendi."
  },
  {
   "tr": "Şimdi neredeyse her gün resim yapıyor ve bazı resimleri kasaba kütüphanesindeki küçük bir sergide gösterildi."
  }
 ],
