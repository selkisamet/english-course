{
 "storyId": "story-a1-019",
 "textHash": "9a49085d828f",
 "source": "manual",
 "sentences": [
  {
   "tr": "Sam'in okul için yeni ayakkabıya ihtiyacı var."
  },
  {
   "tr": "Eski ayakkabıları çok küçük geliyor."
  },
  {
   "tr": "Cumartesi günü annesiyle bir ayakkabı mağazasına gidiyor."
  },
  {
   "tr": "Mağazada çok sayıda ayakkabı var."
  },
  {
   "tr": "Sam bir çift siyah ayakkabıyı beğeniyor."
  },
  {
   "tr": "Onları deniyor ve rahatlar."
  },
  {
   "tr": "Annesi \"Bunlar ne kadar?\" diye soruyor."
  },
  {
   "tr": "Mağazadaki kadın \"Kırk dolar,\" diyor."
  },
  {
   "tr": "Ayakkabıları alıp eve gidiyorlar."
  }
 ],
