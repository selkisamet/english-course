{
 "storyId": "story-a2-040",
 "textHash": "06f39ad2eed3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Okul tatilinde ailemle bir tepenin üzerindeki eski bir kaleyi gezdik."
  },
  {
   "tr": "Kale sekiz yüz yıldan daha eski."
  },
  {
   "tr": "Bir rehber bize etrafı gezdirdi ve orada yaşamış insanları anlattı."
  },
  {
   "tr": "Kralın misafirleriyle akşam yemeği yediği büyük salonu gördük."
  },
  {
   "tr": "Ayrıca dar bir merdivenden bir kulenin tepesine tırmandık."
  },
  {
   "tr": "Oradan bütün kasabayı ve nehri görebiliyorduk."
  },
  {
   "tr": "Küçük erkek kardeşim bütün gün orada kalmak istedi!"
  }
 ],
