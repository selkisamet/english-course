{
 "storyId": "story-c2-018",
 "textHash": "5b07d4b5e852",
 "source": "manual",
 "sentences": [
  {
   "tr": "İnsanlık tarihinin büyük bölümünde zaman güneşe, mevsimlere ve kilise çanlarının çalmasına göre kabaca ölçülürdü."
  },
  {
   "tr": "Kesin ve standart saatleri talep eden herhangi bir filozof değil, demiryoluydu; çünkü trenler onlarca farklı yerel saate göre güvenli biçimde işleyemezdi."
  },
  {
   "tr": "Böylece dakiklik kişisel bir erdemden ekonomik bir zorunluluğa dönüştü."
  },
  {
   "tr": "Bugün onun disiplinine o kadar alışkınız ki ne kadar yakın bir zamanda ve ne kadar keyfî biçimde dayatıldığını nadiren fark ederiz."
  }
 ],
