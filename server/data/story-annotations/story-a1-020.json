{
 "storyId": "story-a1-020",
 "textHash": "76c2ce3675c4",
 "source": "manual",
 "sentences": [
  {
   "tr": "Peter ailesiyle birlikte bir çiftlikte yaşıyor."
  },
  {
   "tr": "Her gün saat beşte kalkıyor."
  },
  {
   "tr": "Önce ineklere ve tavuklara yem veriyor."
  },
  {
   "tr": "Sonra tavukların yumurtalarını topluyor."
  },
  {
   "tr": "Kız kardeşi ona yardım ediyor."
  },
  {
   "tr": "Ardından aile mutfakta büyük bir kahvaltı yapıyor."
  },
  {
   "tr": "Yumurta, ekmek ve peynir yiyorlar."
  },
  {
   "tr": "Çiftlik işi zor ama Peter onu çok seviyor."
  }
 ],
