 "source": "manual",
 "sentences": [
  {
   "tr": "Minimalist akım, başarıyı biriktirmeyle tanımlayan tüketim kültürüne karşı bir tepkidir."
  },
  {
   "tr": "İnsan gereksiz olanı çıkararak zihinsel berraklığa yer açar."
  },
  {
   "tr": "Bu yalnızca bir tasarım tercihi değil, bir yaşam felsefesidir."
  },
  {
   "tr": "Onu benimseyenler, maddi eşyaların yükünden kurtulmuş olarak çoğu zaman derin bir özgürlük duygusu yaşadıklarını söylüyor."
  }
 ],
