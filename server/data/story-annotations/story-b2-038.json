{
 "storyId": "story-b2-038",
 "textHash": "7a1c7833a78f",
 "source": "manual",
 "sentences": [
  {
   "tr": "Yıllarca köyümüzdeki çocuklar, ara yolun sonundaki boş evin perili olduğuna inandı."
  },
  {
   "tr": "Geceleri içeride hareket eden ışıklar gördüklerini ve tuhaf sesler duyduklarını iddia ediyorlardı."
  },
  {
   "tr": "Geçen yaz gizem sonunda çözüldü."
  },
  {
   "tr": "Çatının altında bir kuş ailesi yaşıyormuş ve ışıklar sadece geçen arabaların yansımalarıymış."
  },
  {
   "tr": "Ev artık onarıldı ve genç bir çift oraya taşındı."
  },
  {
   "tr": "Yine de bazı çocuklar hava karardıktan sonra hâlâ evin önünden geçmeyi reddediyor."
  }
 ],
