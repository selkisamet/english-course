 "source": "manual",
 "sentences": [
  {
   "tr": "Bay ve Bayan Wood tatildeler."
  },
  {
   "tr": "Sahilin yakınındaki bir otele varıyorlar."
  },
  {
   "tr": "Resepsiyondaki kadın gülümsüyor ve \"Hoş geldiniz!\" diyor."
  },
  {
   "tr": "Onlara odalarının anahtarını veriyor."
  },
  {
   "tr": "Oda üçüncü katta."
  },
  {
   "tr": "Odada büyük bir yatak, küçük bir masa ve bir balkon var."
  },
  {
   "tr": "Balkondan denizi görebiliyorlar."
  },
  {
   "tr": "Bayan Wood \"Burası mükemmel,\" diyor."
  }
 ],
