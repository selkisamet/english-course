{
 "storyId": "story-b1-028",
 "textHash": "6d96de5bd65f",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yıl Nina ucuz seyahat hakkında bir blog yazmaya başladı."
  },
  {
   "tr": "İlk başta onu sadece arkadaşları okuyordu."
  },
  {
   "tr": "Gezdiği yerleri yazdı ve nasıl para biriktirileceği konusunda tavsiyeler verdi."
  },
  {
   "tr": "Kendi fotoğraflarını da ekledi."
  },
  {
   "tr": "Yavaş yavaş giderek daha fazla insan blogunu buldu ve bazıları ona sorularla dolu mesajlar gönderdi."
  },
  {
   "tr": "Şimdi her ay binlerce okuru var."
  },
  {
   "tr": "Hatta bir seyahat şirketi ondan web siteleri için makaleler yazmasını istedi."
  }
 ],
