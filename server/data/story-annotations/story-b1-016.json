 "source": "manual",
 "sentences": [
  {
   "tr": "Rosa tavan arasını temizlerken, büyükannesine ait olmuş küçük bir günlük buldu."
  },
  {
   "tr": "Günlük altmış yıldan daha uzun bir süre önce, büyükannesi bir gençken yazılmıştı."
  },
  {
   "tr": "Rosa oturdu ve okumaya başladı."
  },
  {
   "tr": "Büyükannesi okulunu, en yakın arkadaşını ve hoşlandığı bir çocuğu yazmıştı."
  },
  {
   "tr": "Rosa hayatlarının ne kadar benzer olduğunu keşfedince şaşırdı."
  },
  {
   "tr": "O akşam günlüğü annesine gösterdi ve birlikte hem güldüler hem ağladılar."
  }
 ],
