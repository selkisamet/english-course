{
 "storyId": "story-a1-043",
 "textHash": "230faa3b1798",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün Bayan Brown'ın sınıfı şehir müzesinde."
  },
  {
   "tr": "Müze çok eski ve çok büyük."
  },
  {
   "tr": "Çocuklar eski paralar, resimler ve kocaman bir dinozor görüyor."
  },
  {
   "tr": "En sevdikleri dinozor oluyor."
  },
  {
   "tr": "Bir adam onlara şehrin tarihini anlatıyor."
  },
  {
   "tr": "Çocuklar dinliyor ve bir sürü soru soruyor."
  },
  {
   "tr": "Ziyaretin sonunda müze dükkânından kartpostal alıyorlar."
  }
 ],
