{
 "storyId": "story-a2-028",
 "textHash": "a7d880959348",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen pazar Peter amcam beni ilk kez balık tutmaya götürdü."
  },
  {
   "tr": "Saat beşte kalktık ve arabayla sessiz bir göle gittik."
  },
  {
   "tr": "Peter amcam bana oltanın ipini suya nasıl atacağımı gösterdi."
  },
  {
   "tr": "Sonra oturup uzun süre bekledik."
  },
  {
   "tr": "Tam sıkılmaya başlamıştım ki bir şey birden ipimi çekti."
  },
  {
   "tr": "Büyük bir balık yakaladım!"
  },
  {
   "tr": "Fotoğrafını çektik ve sonra onu suya geri bıraktık."
  },
  {
   "tr": "Harika bir gündü."
  }
 ],
