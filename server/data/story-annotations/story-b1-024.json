{
 "storyId": "story-b1-024",
 "textHash": "93756de385b3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Elena'nın büyükannesi hayattayken ailedeki en güzel elmalı keki o yapardı."
  },
  {
   "tr": "Ne yazık ki tarifi hiçbir zaman bir yere yazmadı."
  },
  {
   "tr": "Büyükannesi öldükten sonra Elena keki birçok kez yapmayı denedi ama hiçbir zaman aynı tadı vermedi."
  },
  {
   "tr": "Geçen ay büyükannesinin bir arkadaşına göndermiş olduğu eski bir mektup buldu."
  },
  {
   "tr": "Mektupta tarifin tamamı vardı!"
  },
  {
   "tr": "Elena keki annesinin doğum günü için pişirdi ve herkes tadının tıpkı aslı gibi olduğunu söyledi."
  }
 ],
