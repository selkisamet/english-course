 "sentences": [
  {
   "tr": "İnsan zihnini keşfetmek, çıkışı olmayan bir labirentte yol bulmaya çalışmaktır."
  },
  {
   "tr": "Filozof hayatını öz farkındalığın doğası üzerine düşünerek geçirdi."
  },
  {
   "tr": "Bilincin tek bir varlık değil, hafızanın kırılgan ipliğiyle bir arada tutulan algılardan oluşan bir bütün olduğunu öne sürdü."
  },
  {
   "tr": "Önemli çalışması, Batı düşüncesine yüzyıllardır hâkim olan ikiliğe meydan okudu."
  }
 ],
