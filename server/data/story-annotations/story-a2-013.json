 "source": "manual",
 "sentences": [
  {
   "tr": "Gelecek hafta kız kardeşimin doğum günü, bu yüzden pazar günü ona bir hediye almak için alışveriş merkezine gittim."
  },
  {
   "tr": "Önce birkaç kazağa baktım ama çok pahalıydılar."
  },
  {
   "tr": "Sonra bir kitapçıya girdim."
  },
  {
   "tr": "Kız kardeşim yemek yapmayı çok seviyor ve İtalyan yemek tarifleri olan güzel bir kitap buldum."
  },
  {
   "tr": "Yirmi sterlin tuttu."
  },
  {
   "tr": "Satış görevlisi onu benim için kırmızı kâğıda sardı."
  },
  {
   "tr": "Bence kız kardeşim ona bayılacak."
  }
 ],
