 "source": "manual",
 "sentences": [
  {
   "tr": "Dün gece telefonum saat on birde çaldı."
  },
  {
   "tr": "Bir adam, \"Orası Pizza Palace mı?\" diye sordu."
  },
  {
   "tr": "\"Büyük boy bir pizza sipariş etmek istiyorum.\""
  },
  {
   "tr": "Ona yanlış numarayı aradığını söyledim."
  },
  {
   "tr": "On dakika sonra aynı soruyla yine aradı."
  },
  {
   "tr": "Kibarca bunun özel bir numara olduğunu açıkladım."
  },
  {
   "tr": "Ertesi gün internete baktım."
  },
  {
   "tr": "Pizza restoranının numarası benimkiyle neredeyse aynıydı."
  },
  {
   "tr": "Yalnızca bir rakam farklıydı!"
  }
 ],
