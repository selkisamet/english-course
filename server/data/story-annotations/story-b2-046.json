{
 "storyId": "story-b2-046",
 "textHash": "af07d2f6b1e3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Elena mezun olduktan sonra, neredeyse hiç Japonca bilmemesine rağmen Japonya'da küçük bir kasabada öğretmenlik işini kabul etti."
  },
  {
   "tr": "İlk birkaç ay zordu."
  },
  {
   "tr": "Sık sık yalnız hissediyordu ve süpermarketteki etiketleri okumak gibi gündelik işlerde zorlanıyordu."
  },
  {
   "tr": "Ancak iş arkadaşları sabırlıydı ve yeni hayatına alışmasına yardım ettiler."
  },
  {
   "tr": "Dil derslerine başladı ve yavaş yavaş arkadaş edindi."
  },
  {
   "tr": "Üç yıl sonra hâlâ orada yaşıyor ve yurt dışına taşınmanın hayatında verdiği en iyi karar olduğunu söylüyor."
  }
 ],
