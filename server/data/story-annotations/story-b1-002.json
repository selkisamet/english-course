{
 "storyId": "story-b1-002",
 "textHash": "e795e989f3fc",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen hafta sonu Mike kampa gitti."
  },
  {
   "tr": "Gecenin ortasında garip bir ses onu uyandırdı."
  },
  {
   "tr": "Vahşi bir hayvana benziyordu!"
  },
  {
   "tr": "Dehşete kapıldı."
  },
  {
   "tr": "Hemen arkadaşlarını uyandırdı."
  },
  {
   "tr": "Birden küçük bir kedi çadırlarına girdi."
  },
  {
   "tr": "Hepsi güldü."
  },
  {
   "tr": "Bu bir ayı değildi; sadece aç bir sokak kedisiydi."
  },
  {
   "tr": "Kediye biraz yiyecek verdiler."
  },
  {
   "tr": "Korkutucu ama eğlenceli bir deneyimdi."
  }
 ],
