{
 "storyId": "story-a2-034",
 "textHash": "e1c318682dcd",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen pazar annemin doğum günüydü, bu yüzden kız kardeşimle ben ona yatağına kahvaltı hazırlamaya karar verdik."
  },
  {
   "tr": "Çok erken kalktık ve sessizce mutfağa gittik."
  },
  {
   "tr": "Kız kardeşim kahve ve portakal suyu hazırladı, ben de yumurta ve kızarmış ekmek yaptım."
  },
  {
   "tr": "Tepsiye küçük bir çiçek de koyduk."
  },
  {
   "tr": "Sonra her şeyi üst kata taşıdık ve annemin kapısını çaldık."
  },
  {
   "tr": "Annem çok şaşırdı ve mutlu oldu."
  },
  {
   "tr": "Hayatının en güzel kahvaltısı olduğunu söyledi."
  }
 ],
