{
 "storyId": "story-b1-029",
 "textHash": "958f25479f89",
 "source": "manual",
 "sentences": [
  {
   "tr": "Mark büyük bir mağazanın müşteri hizmetleri masasında çalışıyor."
  },
  {
   "tr": "Bir öğleden sonra masaya kızgın bir kadın geldi."
  },
  {
   "tr": "Bir kahve makinesi almıştı ama makine iki gün sonra çalışmayı bırakmıştı."
  },
  {
   "tr": "Mark onu dikkatle dinledi ve özür diledi."
  },
  {
   "tr": "Yeni bir makine ile parasının iadesi arasında seçim yapabileceğini açıkladı."
  },
  {
   "tr": "Kadın sakinleşti ve yeni bir makine seçti."
  },
  {
   "tr": "Ayrılmadan önce bu kadar kibar ve sabırlı olduğu için Mark'a teşekkür etti."
  }
 ],
