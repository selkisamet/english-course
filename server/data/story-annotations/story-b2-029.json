{
 "storyId": "story-b2-029",
 "textHash": "8e4fcdee6473",
 "source": "manual",
 "sentences": [
  {
   "tr": "Yıllarca kasabamızdaki halk kütüphanesi eskiydi ve nadiren ziyaret ediliyordu."
  },
  {
   "tr": "Belediye kütüphanenin kapanabileceğini duyurunca yerel halk onu kurtarmak için bir kampanya düzenledi."
  },
  {
   "tr": "Binlerce imza topladılar ve konserler ile kitap satışları aracılığıyla para topladılar."
  },
  {
   "tr": "Sonunda belediye bunun yerine binayı modernleştirmeyi kabul etti."
  },
  {
   "tr": "Yeni kütüphanede rahat okuma alanları, bir kafe ve ücretsiz bilgisayarlar var ve artık kasabanın en kalabalık yerlerinden biri."
  }
 ],
