{
 "storyId": "story-b1-039",
 "textHash": "b42d38078a53",
 "source": "manual",
 "sentences": [
  {
   "tr": "David yıllarca hiç kahvaltı yapmadı."
  },
  {
   "tr": "Genellikle işe giderken büyük bir kahve içer ve saat on bire doğru acıkırdı."
  },
  {
   "tr": "Sonra masasında sık sık bisküvi ve çikolata yerdi."
  },
  {
   "tr": "Doktoru ona sağlıklı bir kahvaltının ona daha fazla enerji vereceğini söyledi."
  },
  {
   "tr": "Bu yüzden David her sabah meyveli yulaf lapası yemeye başladı."
  },
  {
   "tr": "Birkaç hafta sonra kendini daha az yorgun hissettiğini fark etti ve artık tatlı atıştırmalıklar canı çekmiyordu."
  },
  {
   "tr": "Ayrıca biraz kilo da verdi."
  }
 ],
