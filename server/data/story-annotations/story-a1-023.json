 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün hava çok soğuk."
  },
  {
   "tr": "Yerde ve ağaçlarda kar var."
  },
  {
   "tr": "Max sıcak tutan montunu, şapkasını ve eldivenlerini giyiyor."
  },
  {
   "tr": "Kız kardeşiyle dışarı çıkıyor."
  },
  {
   "tr": "Bahçede bir kardan adam yapıyorlar."
  },
  {
   "tr": "Kardan adamın burnu bir havuç."
  },
  {
   "tr": "Bir saat sonra elleri üşüyor."
  },
  {
   "tr": "İçeri giriyorlar ve anneleri onlara sıcak çikolata yapıyor."
  }
 ],
