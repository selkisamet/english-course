{
 "storyId": "story-b1-030",
 "textHash": "74d8570fd3d5",
 "source": "manual",
 "sentences": [
  {
   "tr": "Okulu bitirmelerinden yirmi yıl sonra Paula'nın eski sınıf arkadaşları bir buluşma düzenledi."
  },
  {
   "tr": "Paula gergindi çünkü çoğunu on sekiz yaşından beri görmemişti."
  },
  {
   "tr": "Restorana vardığında bazı kişileri neredeyse tanıyamadı."
  },
  {
   "tr": "Diğerleri ise hiç değişmemişti."
  },
  {
   "tr": "Eski fotoğraflara baktılar, öğretmenleri ve okul gezileri hakkında gülüştüler."
  },
  {
   "tr": "Paula, okuldaki en yakın arkadaşının artık kendi kasabasında yaşadığını öğrenince şaşırdı."
  },
  {
   "tr": "O zamandan beri her hafta buluşuyorlar."
  }
 ],
