{
 "storyId": "story-b1-025",
 "textHash": "05e49d07418f",
 "source": "manual",
 "sentences": [
  {
   "tr": "Michael büyük bir hastanede hemşire olarak çalışıyor ve bu ay gece vardiyasında çalışıyor."
  },
  {
   "tr": "Akşam dokuzda başlayıp sabah yedide bitiriyor."
  },
  {
   "tr": "Hastane gece daha sakin ama yine de yardıma ihtiyacı olan birçok hasta var."
  },
  {
   "tr": "En zor kısmı gündüz uyumak, çünkü şehir çok gürültülü."
  },
  {
   "tr": "Yatak odasını karanlık tutmak için kalın perdeler kullanıyor."
  },
  {
   "tr": "İş yorucu olsa da insanlara yardım etmeyi çok sevdiğini söylüyor."
  }
 ],
