{
 "storyId": "story-a1-021",
 "textHash": "f02670913d7a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Küçük bir erkek kardeşim var."
  },
  {
   "tr": "Adı Leo ve dört yaşında."
  },
  {
   "tr": "Leo'nun büyük mavi gözleri ve kısa kahverengi saçları var."
  },
  {
   "tr": "Arabaları ve trenleri sever."
  },
  {
   "tr": "Her sabah beni saat altıda uyandırır."
  },
  {
   "tr": "Yatağımın üstünde zıplar ve \"Benimle oyna!\" der."
  },
  {
   "tr": "Bazen gürültücüdür ama çok tatlıdır."
  },
  {
   "tr": "Geceleri ona hikâye okurum."
  },
  {
   "tr": "Küçük kardeşimi çok seviyorum."
  }
 ],
