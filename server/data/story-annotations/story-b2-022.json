{
 "storyId": "story-b2-022",
 "textHash": "3b4b6d9d903a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Paul'un çocukları dairesine akıllı bir hoparlör koyduğunda Paul buna şüpheyle yaklaştı."
  },
  {
   "tr": "Neredeyse seksen yaşındaydı ve cep telefonundan daha karmaşık hiçbir şey kullanmamıştı."
  },
  {
   "tr": "Yine de birkaç hafta içinde ondan en sevdiği radyo istasyonunu çalmasını, ilacını içmeyi hatırlatmasını ve torunlarını aramasını istiyordu."
  },
  {
   "tr": "Ailesini en çok şaşırtan, onun ne kadar daha bağımsız hale geldiği oldu."
  },
  {
   "tr": "Artık günlük küçük işler için yardım istemesine gerek kalmamıştı."
  }
 ],
