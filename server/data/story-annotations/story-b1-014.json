 "textHash": "94dd6ebaf5f1",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen ay Ben internetten yeni bir ceket sipariş etti."
  },
  {
   "tr": "Fotoğrafta koyu yeşil ve şık görünüyordu."
  },
  {
   "tr": "Paket bir hafta sonra geldiğinde hayal kırıklığına uğradı."
  },
  {
   "tr": "Ceket parlak sarıydı ve iki beden büyüktü."
  },
  {
   "tr": "Siparişini kontrol etti ve yanlış bedeni kendisinin seçtiğini fark etti."
  },
  {
   "tr": "Neyse ki mağaza, müşterilerin ürünleri ücretsiz iade etmesine izin veriyordu."
  },
  {
   "tr": "Ben ceketi geri gönderdi ve bir dahaki sefere ayrıntıları daha dikkatli okuyacak."
  }
 ],
