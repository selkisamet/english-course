 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yaz ailemle İspanya'ya seyahat ettik."
  },
  {
   "tr": "Uçakla gittik."
  },
  {
   "tr": "İlk kez uçağa biniyordum, bu yüzden biraz gergindim."
  },
  {
   "tr": "Ama yolculuk sorunsuz geçti."
  },
  {
   "tr": "Sahilin yakınında güzel bir otelde kaldık."
  },
  {
   "tr": "Hava her gün harikaydı."
  },
  {
   "tr": "Okyanusta yüzdük ve yöresel yemekler yedik."
  },
  {
   "tr": "Bir gece geleneksel bir dans gösterisi izledik."
  },
  {
   "tr": "Hayatımın en güzel tatiliydi."
  }
 ],
