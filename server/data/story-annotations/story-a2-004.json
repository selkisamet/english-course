 "source": "manual",
 "sentences": [
  {
   "tr": "Gelecek ay New York'a taşınacağım."
  },
  {
   "tr": "Orada mimar olarak yeni bir iş buldum."
  },
  {
   "tr": "Çok heyecanlıyım ama arkadaşlarımdan ayrılacağım için biraz da üzgünüm."
  },
  {
   "tr": "Brooklyn'de küçük bir daire kiralayacağım."
  },
  {
   "tr": "Kutularımı toplamaya çoktan başladım."
  },
  {
   "tr": "Arkadaşlarım bu hafta sonu bana yardım etmeyi teklif etti."
  },
  {
   "tr": "Bu, hayatımda yeni bir başlangıç."
  }
 ],
