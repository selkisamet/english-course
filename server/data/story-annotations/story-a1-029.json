 "source": "manual",
 "sentences": [
  {
   "tr": "Jack'in yeni bir telefonu var."
  },
  {
   "tr": "Annesiyle babasından bir hediye."
  },
  {
   "tr": "Telefon küçük ve siyah, büyük bir ekranı var."
  },
  {
   "tr": "Jack arkadaşlarının ve kedisinin fotoğraflarını çekiyor."
  },
  {
   "tr": "Kanada'daki kuzenine mesaj gönderiyor."
  },
  {
   "tr": "Ama annesiyle babasının bir kuralı var: yemekte telefon yok ve saat dokuzdan sonra telefon yok."
  },
  {
   "tr": "Jack bunun iyi bir kural olduğunu düşünüyor."
  }
 ],
