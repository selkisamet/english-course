 "source": "manual",
 "sentences": [
  {
   "tr": "Sevgili Julie, bu mektubu Paris'ten yazıyorum."
  },
  {
   "tr": "Buraya üç gün önce geldim."
  },
  {
   "tr": "Şehir harika."
  },
  {
   "tr": "Dün Eyfel Kulesi'ni gezdim."
  },
  {
   "tr": "Kocaman."
  },
  {
   "tr": "Tepeden manzara inanılmazdı."
  },
  {
   "tr": "Ayrıca popüler bir kafede kahve içtim."
  },
  {
   "tr": "Bir hafta daha burada kalacağım."
  },
  {
   "tr": "Sana bir hediye aldım."
  },
  {
   "tr": "Görüşürüz!"
  },
  {
   "tr": "Sevgiler, Anna."
  }
 ],
