{
 "storyId": "story-b2-017",
 "textHash": "2e0b1e6ce776",
 "source": "manual",
 "sentences": [
  {
   "tr": "Küçük bir mobilya şirketi ürünlerini Japonya'da piyasaya sürmeye hazırlanıyordu."
  },
  {
   "tr": "Para tasarrufu yapmak için müdür, profesyonel bir çevirmen tutmak yerine talimatları çevirmek için ücretsiz bir çevrimiçi araç kullandı."
  },
  {
   "tr": "Ne yazık ki birkaç cümle o kadar kötü çevrildi ki müşteriler mobilyayı nasıl kuracaklarını anlayamadı."
  },
  {
   "tr": "Bir hafta içinde onlarca şikâyet geldi ve şirket yeni talimatlar basmak zorunda kaldı."
  },
  {
   "tr": "Sonunda bu hata onlara profesyonel bir çevirinin tutacağından çok daha pahalıya mal oldu."
  }
 ],
