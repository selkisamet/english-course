{
 "storyId": "story-a2-027",
 "textHash": "93b713141bab",
 "source": "manual",
 "sentences": [
  {
   "tr": "Her cumartesi sabahı babamla birlikte kasaba meydanındaki pazara gideriz."
  },
  {
   "tr": "Pazar her zaman kalabalık ve gürültülüdür."
  },
  {
   "tr": "İnsanlar taze meyve, sebze, balık, peynir ve çiçek satar."
  },
  {
   "tr": "Babam pazardaki insanlarla konuşmayı sever ve onların birçoğunu tanır."
  },
  {
   "tr": "Bugün domates, patates, büyük bir kavun ve biraz bal aldık."
  },
  {
   "tr": "Balcı bana bedavaya küçük bir dilim kek verdi."
  },
  {
   "tr": "Çantalarımız çok ağırdı ama aldıklarımızdan memnunduk."
  }
 ],
