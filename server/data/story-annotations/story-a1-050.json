{
 "storyId": "story-a1-050",
 "textHash": "f9e9460ff677",
 "source": "manual",
 "sentences": [
  {
   "tr": "Emily'nin dişi ağrıyor."
  },
  {
   "tr": "Annesi dişçiyi arıyor ve öğleden sonra oraya gidiyorlar."
  },
  {
   "tr": "Emily biraz korkuyor."
  },
  {
   "tr": "Dişçi güler yüzlü bir adam."
  },
  {
   "tr": "\"Ağzını aç lütfen,\" diyor."
  },
  {
   "tr": "Küçük bir ışıkla dişlerine bakıyor."
  },
  {
   "tr": "\"Büyük bir sorun değil,\" diyor."
  },
  {
   "tr": "Yirmi dakika sonra ağrı geçiyor."
  },
  {
   "tr": "Emily kendini çok daha iyi hissediyor."
  }
 ],
