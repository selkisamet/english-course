 "source": "manual",
 "sentences": [
  {
   "tr": "Julian titiz bir planlamacıydı ve çalıştığı hukuk bürosunda ortak olmaya hazırlanıyordu."
  },
  {
   "tr": "Ancak Leo adında sıra dışı bir sanatçıyla asansörde mahsur kalmak her şeyi değiştirdi."
  },
  {
   "tr": "Sohbetleri derin bir terapi seansına dönüştü."
  },
  {
   "tr": "Julian kendisine uymayan bir kariyerin peşinden gittiğini fark etti."
  },
  {
   "tr": "Mutfak sanatlarıyla uğraşmak için işinden ayrıldı; bu karar ruhunu özgür bıraktı."
  }
 ],
