 "sentences": [
  {
   "tr": "Geçen pazar bir piknik düzenledik."
  },
  {
   "tr": "Hava tahmini güneşli olacağını söylüyordu."
  },
  {
   "tr": "Arabayla ormana gittik ve yemeye başladık."
  },
  {
   "tr": "Birden kara bulutlar belirdi ve şiddetli yağmur yağdı."
  },
  {
   "tr": "Hızla arabaya koştuk."
  },
  {
   "tr": "Sırılsıklam olmuştuk."
  },
  {
   "tr": "Sandviçlerimizi aracın içinde yedik."
  },
  {
   "tr": "Aslında pikniklerin yeri güneşli günlerdir ama bu piknik çok eğlenceliydi."
  }
 ],
