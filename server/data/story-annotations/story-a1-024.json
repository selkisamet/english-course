{
 "storyId": "story-a1-024",
 "textHash": "41f1167fe5d7",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bir köpeğim var."
  },
  {
   "tr": "Adı Rex."
  },
  {
   "tr": "Üç yaşında ve siyah beyaz renkte."
  },
  {
   "tr": "Rex çok cana yakındır."
  },
  {
   "tr": "İnsanları ve diğer köpekleri sever."
  },
  {
   "tr": "Her akşam onu parkta yürüyüşe çıkarırım."
  },
  {
   "tr": "Topun peşinden koşar ve onu bana geri getirir."
  },
  {
   "tr": "Rex günde iki kez yemek yer."
  },
  {
   "tr": "Geceleri mutfaktaki küçük bir yatakta uyur."
  }
 ],
