 "sentences": [
  {
   "tr": "Dün iki departman arasında ciddi bir yanlış anlaşılma yaşandı."
  },
  {
   "tr": "Pazarlama ekibi, tasarım ekibinin broşürleri tamamladığını sanıyordu ama tamamlamamışlardı."
  },
  {
   "tr": "Bu da lansmanda gecikmeye yol açtı."
  },
  {
   "tr": "Sorunu çözmek için bir toplantı yapıldı."
  },
  {
   "tr": "Bir e-postanın yanlış adrese gönderildiği ortaya çıktı."
  },
  {
   "tr": "Gelecekte hata olmaması için iletişim kanallarını iyileştirmeye karar verdiler."
  }
 ],
