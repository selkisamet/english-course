 "sentences": [
  {
   "tr": "Garcia ailesinde her cuma pizza gecesidir."
  },
  {
   "tr": "Bay Garcia yemeği evde yapar, çocuklar da ona yardım eder."
  },
  {
   "tr": "Maria ekmeğin üstüne domates koyar, erkek kardeşi de üstüne peynir ve sebze koyar."
  },
  {
   "tr": "Sonra Bay Garcia onu on beş dakika pişirir."
  },
  {
   "tr": "Mutfak çok güzel kokar!"
  },
  {
   "tr": "Aile televizyonun karşısında birlikte yemek yer ve film izler."
  },
  {
   "tr": "Haftanın en sevdikleri gecesidir."
  }
 ],
