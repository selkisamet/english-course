{
 "storyId": "story-a2-018",
 "textHash": "578e5d8a51ba",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen hafta bizimkinin yanındaki eve yeni bir aile taşındı."
  },
  {
   "tr": "İki küçük çocukları ve büyük, kahverengi bir köpekleri var."
  },
  {
   "tr": "Çarşamba günü annem bir kek yaptı ve onu onlara götürdük."
  },
  {
   "tr": "Anne babaları çok cana yakındı ve bizi çaya davet ettiler."
  },
  {
   "tr": "Bize Kanada'dan geldiklerini söylediler."
  },
  {
   "tr": "Kızları benimle aynı yaşta ve gelecek pazartesi benim okuluma başlayacak."
  },
  {
   "tr": "Umarım arkadaş olabiliriz."
  }
 ],
