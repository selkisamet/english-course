{
 "storyId": "story-b2-025",
 "textHash": "c60bbd074b1e",
 "source": "manual",
 "sentences": [
  {
   "tr": "Rahmetli teyzesinin tavan arasını boşaltırken Clara adında genç bir editör, el yazısıyla dolu sayfaların olduğu bir kutu buldu."
  },
  {
   "tr": "Şaşkınlıkla gördü ki bu, tamamlanmış bir romandı."
  },
  {
   "tr": "Görünüşe göre teyzesi onu onlarca yıl önce yazmış ama kimseye göstermemişti."
  },
  {
   "tr": "Clara sayfaları bilgisayara geçirip küçük hataları düzelterek aylar geçirdi."
  },
  {
   "tr": "Kitap sonunda yayımlandığında eleştirmenler içtenliğini övdü ve kitap şaşırtıcı bir başarı kazandı."
  }
 ],
