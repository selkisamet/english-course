{
 "storyId": "story-b1-041",
 "textHash": "e3eb2aca0c8d",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen kış Maria İspanyolca öğrenmeye karar verdi ama akşam kurslarına gidecek vakti yoktu."
  },
  {
   "tr": "Onun yerine çevrimiçi bir kursa kaydoldu."
  },
  {
   "tr": "Her akşam yemekten sonra dizüstü bilgisayarında kısa videolar izledi ve alıştırmalar yaptı."
  },
  {
   "tr": "Haftada bir kez Meksikalı bir öğretmenle görüntülü ders yaptı."
  },
  {
   "tr": "İlk başta başka öğrenciler olmadan tek başına çalışmayı zor buldu."
  },
  {
   "tr": "Ancak altı ay sonra İspanyolca basit sohbetler yapabiliyordu."
  }
 ],
