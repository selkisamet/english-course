{
 "storyId": "story-a2-033",
 "textHash": "74bfa31c12a3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Cumartesi sabahı annem, \"Büyükannenle büyükbaban bu akşam yemeğe geliyor ve ev darmadağın!\" dedi."
  },
  {
   "tr": "Bu yüzden herkes yardım etti."
  },
  {
   "tr": "Babam yerleri temizledi, erkek kardeşim de pencereleri yıkadı."
  },
  {
   "tr": "Ben yatak odamı topladım ve bütün kıyafetlerimi yerine kaldırdım."
  },
  {
   "tr": "Sonra mutfakta anneme yardım ettim."
  },
  {
   "tr": "Saat beşe kadar ev tertemiz ve derli toplu olmuştu."
  },
  {
   "tr": "Büyükannemle büyükbabam geldiğinde büyükannem, \"Ne güzel, tertemiz bir ev!\" dedi."
  },
  {
   "tr": "Hepimiz birbirimize gülümsedik."
  }
 ],
