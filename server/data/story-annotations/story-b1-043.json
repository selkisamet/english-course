 "source": "manual",
 "sentences": [
  {
   "tr": "Ocak ayında elektrik faturaları geldiğinde Brown ailesi çok şaşırdı."
  },
  {
   "tr": "Fatura bir önceki yılın iki katıydı."
  },
  {
   "tr": "Bazı değişiklikler yapmaya karar verdiler."
  },
  {
   "tr": "Bir odadan çıkarken ışıkları kapattılar ve televizyonu bütün gece açık bırakmayı bıraktılar."
  },
  {
   "tr": "Ayrıca kaloriferi açmak yerine kalın kazaklar giydiler."
  },
  {
   "tr": "Üç ay sonra faturaları çok daha düşüktü."
  },
  {
   "tr": "Çocuklar bile anne babalarına bir şeyleri kapatmalarını hatırlatmaya başladı."
  }
 ],
