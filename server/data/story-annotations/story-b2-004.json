 "source": "manual",
 "sentences": [
  {
   "tr": "Kurumsal işinden ayrıldıktan sonra Tom serbest yazar oldu."
  },
  {
   "tr": "Başlangıçta zamanını verimli bir şekilde yönetmekte zorlandı."
  },
  {
   "tr": "Sık sık gece geç saatlere kadar çalışırdı."
  },
  {
   "tr": "Ancak artık sıkı bir düzen oturttu."
  },
  {
   "tr": "Herhangi bir yerden çalışabilme özgürlüğü harika."
  },
  {
   "tr": "Gelecek ay Bali'deki bir sahil evinden çalışmayı planlıyor; bu, her zaman hayaliydi."
  }
