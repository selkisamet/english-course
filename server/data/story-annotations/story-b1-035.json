{
 "storyId": "story-b1-035",
 "textHash": "45f6c184f09d",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen yaz Julia trenle İtalya'yı geziyordu."
  },
  {
   "tr": "Bir sabah acelesi vardı ve bilgileri dikkatle kontrol etmeden bir trene bindi."
  },
  {
   "tr": "Bir saat sonra istasyonların adlarını tanımadığını fark etti."
  },
  {
   "tr": "Yanındaki yolcuya sordu; yolcu trenin Floransa'ya değil, Napoli'ye gittiğini söyledi."
  },
  {
   "tr": "Julia bir sonraki istasyonda indi ve başka bir tren için iki saat bekledi."
  },
  {
   "tr": "Canı sıkılmış olsa da beklerken lezzetli bir pizzanın tadını çıkardı."
  }
 ],
