 "source": "manual",
 "sentences": [
  {
   "tr": "Mark, Paris'e yaptığı kısa bir geziden az önce döndü."
  },
  {
   "tr": "İnanılmaz derecede etkileyici bulduğu Louvre Müzesi'ni gezdi."
  },
  {
   "tr": "Mona Lisa'yı görmek istedi ama kalabalık çok fazlaydı."
  },
  {
   "tr": "Bunun yerine Montmartre'ın sokaklarını keşfetti."
  },
  {
   "tr": "Gerçek Fransız hamur işlerinin tadına baktı."
  },
  {
   "tr": "Fransızcayı akıcı konuşabilseydi bir gün orada yaşamayı çok isteyeceğini söyledi."
  }
 ],
