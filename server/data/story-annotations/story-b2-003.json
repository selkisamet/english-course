 "source": "manual",
 "sentences": [
  {
   "tr": "Şehir merkezinde yaşamanın avantajları var ama sürekli gürültü büyük bir dezavantaj."
  },
  {
   "tr": "Sarah yakındaki inşaat çalışmaları yüzünden bir süredir uyumakta zorlanıyor."
  },
  {
   "tr": "Belediye meclisine resmî bir şikâyette bulundu ama hiçbir şey değişmedi."
  },
  {
   "tr": "Banliyöye taşınmayı düşünüyor."
  },
  {
   "tr": "Şehrin sunduğu kolaylıkları özleyecek olsa da iç huzuru daha önemli."
  }
 ],
