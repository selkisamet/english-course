 "sentences": [
  {
   "tr": "Sarah meşgul bir öğrencidir."
  },
  {
   "tr": "Her sabah 6.30'da kalkar."
  },
  {
   "tr": "İlk önce bir bardak taze su içer."
  },
  {
   "tr": "Sonra dişlerini fırçalar."
  },
  {
   "tr": "Okul kıyafetlerini giyer."
  },
  {
   "tr": "Kahvaltıda peynirli ekmek yer ve sıcak çay içer."
  },
  {
   "tr": "Sabah 7.30'da otobüs durağına yürür."
  },
  {
   "tr": "Otobüs sarıdır."
  },
  {
   "tr": "Okula sabah 8.00'de varır."
  },
  {
   "tr": "Asla geç kalmaz."
  }
 ],
