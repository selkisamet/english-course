{
 "storyId": "story-a2-045",
 "textHash": "897d5dc303c4",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen hafta arkadaşım Carlos beni beş günlüğüne ziyaret etmek için Meksika'dan geldi."
  },
  {
   "tr": "Ona şehrimin en güzel yerlerini göstermek istedim."
  },
  {
   "tr": "İlk gün eski şehirde dolaştık ve ünlü bir müzeyi gezdik."
  },
  {
   "tr": "İkinci gün nehirde tekne turuna çıktık."
  },
  {
   "tr": "Carlos yöresel yemeklere, özellikle de balığa bayıldı."
  },
  {
   "tr": "Son akşamında bir tepeye çıktık ve güneşin batışını izledik."
  },
  {
   "tr": "Carlos gelecek yıl tekrar gelmek istediğini söylüyor."
  }
 ],
