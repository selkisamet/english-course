 "source": "manual",
 "sentences": [
  {
   "tr": "Alice forma girmeye karar verdi ve bir spor merkezine üye oldu."
  },
  {
   "tr": "Dün ilk seansıydı."
  },
  {
   "tr": "Mike adında bir antrenör ona yardım etti."
  },
  {
   "tr": "Ona koşu bandının nasıl kullanıldığını gösterdi."
  },
  {
   "tr": "Alice yirmi dakika koştu."
  },
  {
   "tr": "Çok yorulmuştu ve yüzü kıpkırmızıydı."
  },
  {
   "tr": "Sonra biraz ağırlık kaldırdı."
  },
  {
   "tr": "Bugün kasları ağrıyor ama kendini iyi hissediyor."
  },
  {
   "tr": "Yarın yine gidecek."
  }
 ],
