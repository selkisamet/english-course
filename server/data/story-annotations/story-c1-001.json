 "source": "manual",
 "sentences": [
  {
   "tr": "Oakhaven köyü, önerilen bir hidroelektrik barajı nedeniyle büyük bir değişimin eşiğindeydi."
  },
  {
   "tr": "Destekçiler, barajın temiz enerji ve istihdam yaratacağını savundu."
  },
  {
   "tr": "Ancak çevreciler ekosistemle ilgili haklı kaygılar dile getirdi."
  },
  {
   "tr": "Belediye başkanı \"Zor bir durum.\" diye kabul etti."
  },
  {
   "tr": "Meclis sakinlere daha önce danışmış olsaydı, olumsuz tepki bu kadar sert olmayabilirdi."
  },
  {
   "tr": "Köy kritik bir dönüm noktasındaydı."
  }
 ],
