 "source": "manual",
 "sentences": [
  {
   "tr": "İki gece önce çok garip bir rüya gördüm."
  },
  {
   "tr": "Rüyamda kasabamın üzerinde uçabiliyordum."
  },
  {
   "tr": "Tatlı şekerden yapılmış bir bulutun üzerine indim."
  },
  {
   "tr": "Birden dev bir kuş belirdi ve \"Uyan!\" dedi."
  },
  {
   "tr": "Sonra gözlerimi açtım."
  },
  {
   "tr": "Saat sabah 7'ydi ve alarmım çalıyordu."
  },
  {
   "tr": "Yorgundum ama bu komik rüya beni eğlendirmişti."
  }
 ],
