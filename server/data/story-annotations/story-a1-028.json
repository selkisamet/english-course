{
 "storyId": "story-a1-028",
 "textHash": "dd3c7cf42270",
 "source": "manual",
 "sentences": [
  {
   "tr": "Annem bir hastanede hemşire."
  },
  {
   "tr": "Çok sıkı çalışır."
  },
  {
   "tr": "Erkenden kalkar ve bize kahvaltı hazırlar."
  },
  {
   "tr": "Sonra arabayla işe gider."
  },
  {
   "tr": "Hastanede bütün gün hasta insanlara yardım eder."
  },
  {
   "tr": "Akşam eve gelir ve akşam yemeği pişirir."
  },
  {
   "tr": "Yemekten sonra ödevlerimizi kontrol eder."
  },
  {
   "tr": "Her zaman meşguldür ama bize her zaman vakit ayırır."
  }
 ],
