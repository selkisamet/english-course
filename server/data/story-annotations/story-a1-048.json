 "source": "manual",
 "sentences": [
  {
   "tr": "Perşembe öğleden sonraları Sara'nın okulda müzik dersi var."
  },
  {
   "tr": "Müzik öğretmeni Bay Lee."
  },
  {
   "tr": "Piyanoyu çok iyi çalıyor."
  },
  {
   "tr": "Derste çocuklar birlikte şarkı söylüyor."
  },
  {
   "tr": "Bazı çocuklar küçük davullar, diğerleri gitar çalıyor."
  },
  {
   "tr": "Sara şarkı söylemeyi, bir çalgı çalmaktan daha çok seviyor."
  },
  {
   "tr": "Gelecek ay sınıf, veliler için küçük bir konser verecek."
  },
  {
   "tr": "Sara biraz gergin ama mutlu."
  }
 ],
