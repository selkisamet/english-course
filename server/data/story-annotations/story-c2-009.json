 "source": "manual",
 "sentences": [
  {
   "tr": "Setler ve barajlar inşa ediyor, yasalar ve antlaşmalar hazırlıyoruz; hepsi kaotik bir evrende denetim kurmaya yönelik çaresiz bir çaba."
  },
  {
   "tr": "Kıyıyı harap eden kasırga, bu kibrin insanı haddini bilmeye zorlayan bir reddiydi."
  },
  {
   "tr": "Felaketin ardından toplum duvarları daha yükseğe yeniden inşa etmedi; bunun yerine çevreyle uyum içinde hareket etmeyi öğrendi."
  },
  {
   "tr": "Bu, hâkimiyetten bir arada yaşamaya doğru köklü bir değişimdi."
  }
 ],
