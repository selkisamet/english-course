 "source": "manual",
 "sentences": [
  {
   "tr": "Emily'nin saçları hep uzundu ama geçen hafta farklı bir şey denemeye karar verdi."
  },
  {
   "tr": "Evinin yakınındaki bir kuaföre gitti ve saçlarını kısa kestirmek istedi."
  },
  {
   "tr": "Aynaya baktığında çok şaşırdı."
  },
  {
   "tr": "Kendini neredeyse tanıyamadı!"
  },
  {
   "tr": "İlk başta beğenmedi."
  },
  {
   "tr": "Ama ertesi gün okulda bütün arkadaşları yeni saçının harika göründüğünü söyledi."
  },
  {
   "tr": "Şimdi Emily kısa saçına bayılıyor ve yıkamasının çok daha kolay olduğunu düşünüyor."
  }
 ],
