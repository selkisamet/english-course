 "textHash": "073855f2d9bb",
 "source": "manual",
 "sentences": [
  {
   "tr": "Dün gece Sanayi Devrimi hakkında büyüleyici bir belgesel izledim."
  },
  {
   "tr": "Belgesel, buhar makinesinin icadının toplumu sonsuza dek nasıl değiştirdiğini anlatıyordu."
  },
  {
   "tr": "Ekonomik büyüme getirse de korkunç bir kirliliğe ve kötü çalışma koşullarına da yol açtı."
  },
  {
   "tr": "Belgeselde, o dönemin sonuçlarıyla bugün hâlâ uğraştığımızı savunan tarihçilerle röportaj yapılmıştı."
  },
  {
   "tr": "Çok öğreticiydi."
  }
 ],
