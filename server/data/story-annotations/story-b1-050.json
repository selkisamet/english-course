{
 "storyId": "story-b1-050",
 "textHash": "0062e4ab7566",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ana her pazar sabahı eski arkadaşı Rita ile tenis oynar."
  },
  {
   "tr": "Okul yıllarından beri birlikte oynuyorlar ve neredeyse her zaman Rita kazanıyor."
  },
  {
   "tr": "Ancak geçen pazar alışılmadık bir şey oldu."
  },
  {
   "tr": "Ana bütün hafta sıkı çalışmıştı ve hiç olmadığı kadar iyi oynadı."
  },
  {
   "tr": "Maç çok çekişmeliydi ve neredeyse iki saat sürdü."
  },
  {
   "tr": "Sonunda son sayıyı Ana kazandı."
  },
  {
   "tr": "Rita güldü ve onun elini sıktı, sonra her zamanki gibi kahve içmeye gittiler."
  }
 ],
