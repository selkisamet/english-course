{
 "storyId": "story-b1-015",
 "textHash": "f7dd24e7d4cd",
 "source": "manual",
 "sentences": [
  {
   "tr": "Jonas üniversiteye başladığında, üç öğrenciyle daha bir daireyi paylaşmaya karar verdi."
  },
  {
   "tr": "İlk başta eğlenceliydi çünkü konuşacak birileri hep vardı."
  },
  {
   "tr": "Ancak çok geçmeden sorunlar ortaya çıktı."
  },
  {
   "tr": "Kimse bulaşıkları yıkamak istemiyordu ve mutfak hep kirliydi."
  },
  {
   "tr": "Bir akşam birlikte oturdular ve her kişi için bir iş listesi yaptılar."
  },
  {
   "tr": "O zamandan beri daire çok daha temiz ve dördü iyi arkadaş oldular."
  }
 ],
