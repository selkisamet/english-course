{
 "storyId": "story-a2-025",
 "textHash": "f39385f9d83e",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen ilkbahar sınıfımız okul bahçesine bir ağaç dikti."
  },
  {
   "tr": "Öğretmenimiz okulun yakınındaki bir dükkândan küçük bir elma ağacı aldı."
  },
  {
   "tr": "Önce iki çocuk yerde büyük bir çukur kazdı."
  },
  {
   "tr": "Sonra ağacı çukura koyduk ve çukuru toprakla doldurduk."
  },
  {
   "tr": "Her öğrenci ağaca biraz su verdi."
  },
  {
   "tr": "Ağaca her hafta bakıyoruz ve şimdi benden daha uzun."
  },
  {
   "tr": "Öğretmenimiz gelecek yıl elma vereceğini söylüyor."
  }
 ],
