 "textHash": "968b60bf2dce",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ailemde kahvaltı önemli bir öğündür."
  },
  {
   "tr": "Her sabah saat yedide kahvaltı yaparız."
  },
  {
   "tr": "Babam kahve, annem çay içer."
  },
  {
   "tr": "Kız kardeşim ve ben süt ya da portakal suyu içeriz."
  },
  {
   "tr": "Genellikle tereyağlı ve reçelli ekmek yeriz."
  },
  {
   "tr": "Bazen yumurta ve peynir yeriz."
  },
  {
   "tr": "Hafta sonu kahvaltıyı geç yapar ve uzun uzun sohbet ederiz."
  }
 ],
