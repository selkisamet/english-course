 "source": "manual",
 "sentences": [
  {
   "tr": "Sarah iki aydır direksiyon dersi alıyor."
  },
  {
   "tr": "Şehirde araba kullanmak stresli çünkü trafik yoğun."
  },
  {
   "tr": "Dün çok dar bir yere park etmesi gerekti."
  },
  {
   "tr": "Üç kez denedi."
  },
  {
   "tr": "Sonunda başardı."
  },
  {
   "tr": "Eğitmeni ona daha sabırlı olması gerektiğini söyledi."
  },
  {
   "tr": "Gelecek hafta ehliyet sınavına girecek."
  },
  {
   "tr": "Geçeceğini umuyor."
  }
 ],
