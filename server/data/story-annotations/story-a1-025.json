{
 "storyId": "story-a1-025",
 "textHash": "834c6bfbbd8b",
 "source": "manual",
 "sentences": [
  {
   "tr": "Mutfağımız evdeki en sevdiğim oda."
  },
  {
   "tr": "Büyük ve aydınlık."
  },
  {
   "tr": "Ortada büyük bir masa var."
  },
  {
   "tr": "Kahvaltıyı ve akşam yemeğini orada yeriz."
  },
  {
   "tr": "Annem yemek yapmayı sever ve mutfak her zaman güzel kokar."
  },
  {
   "tr": "Büyük bir pencere var ve bahçeyi görebiliyoruz."
  },
  {
   "tr": "Pazar günleri babam krep yapar."
  },
  {
   "tr": "Birlikte masaya oturup sohbet ederiz."
  }
 ],
