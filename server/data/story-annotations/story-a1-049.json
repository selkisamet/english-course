 "textHash": "eaff3380ec59",
 "source": "manual",
 "sentences": [
  {
   "tr": "Büyükbabamın çok eski bir arabası var."
  },
  {
   "tr": "Yeşil renkte ve kırk yaşında."
  },
  {
   "tr": "Araba yavaş ve gürültülü ama büyükbabam onu çok seviyor."
  },
  {
   "tr": "Her pazar onu yıkıyor."
  },
  {
   "tr": "Bazen beni kırsala arabayla gezmeye götürüyor."
  },
  {
   "tr": "Pencereleri açıyor ve radyoda eski şarkılar dinliyoruz."
  },
  {
   "tr": "İnsanlar arabaya bakıp gülümsüyor."
  },
  {
   "tr": "Birlikte yaptığımız araba gezilerine bayılıyorum."
  }
 ],
