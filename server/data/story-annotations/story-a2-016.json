 "textHash": "bfe54dedafc3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Okulumuzda her yıl haziranda bir yetenek gösterisi yapılır."
  },
  {
   "tr": "Bu yıl arkadaşım Lucy bir şarkı söylemeye karar verdi."
  },
  {
   "tr": "İki hafta boyunca her gün çalıştı ama gösteriden önce çok gergindi."
  },
  {
   "tr": "Sahneye çıktığında elleri titriyordu."
  },
  {
   "tr": "Sonra müzik başladı ve çok güzel şarkı söyledi."
  },
  {
   "tr": "Salondaki herkes ayağa kalkıp alkışladı."
  },
  {
   "tr": "Lucy birincilik ödülünü kazanmadı ama kendisiyle çok gurur duydu."
  }
 ],
