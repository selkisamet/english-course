 "textHash": "29f181a04a6a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Elif İngilizce, Tom da Türkçe öğreniyor."
  },
  {
   "tr": "Birkaç ay önce bir dil sitesinde tanıştılar."
  },
  {
   "tr": "Şimdi her salı ve perşembe görüntülü konuşuyorlar."
  },
  {
   "tr": "Otuz dakika İngilizce, sonra otuz dakika da Türkçe konuşuyorlar."
  },
  {
   "tr": "Dil bilgisi ve yeni kelimeler konusunda birbirlerine yardım ediyorlar."
  },
  {
   "tr": "Bazen hatalarına gülüyorlar."
  },
  {
   "tr": "Geçen ay Tom İstanbul'a geldi ve sonunda yüz yüze tanıştılar."
  },
  {
   "tr": "Bir kafeye gittiler ve saatlerce konuştular."
  }
 ],
