 "source": "manual",
 "sentences": [
  {
   "tr": "Dün kız kardeşimin doğum günüydü."
  },
  {
   "tr": "Onun için sürpriz bir parti planladık."
  },
  {
   "tr": "Bütün arkadaşlarını davet ettim."
  },
  {
   "tr": "Annem kocaman bir çikolatalı pasta yaptı."
  },
  {
   "tr": "Oturma odasında saklandık."
  },
  {
   "tr": "Kapıyı açınca \"Sürpriz!\" diye bağırdık."
  },
  {
   "tr": "Çok şaşırdı ve mutlu oldu."
  },
  {
   "tr": "Duygusal biri olduğu için biraz ağladı."
  },
  {
   "tr": "Gece yarısına kadar dans edip kutladık."
  }
