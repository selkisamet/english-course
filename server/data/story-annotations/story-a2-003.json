 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen hafta Mark alışveriş merkezinde cüzdanını kaybetti."
  },
  {
   "tr": "Bir ayakkabı mağazasına girdi ve birkaç spor ayakkabı denedi."
  },
  {
   "tr": "Ödeme yapmaya gidince cüzdanının kayıp olduğunu fark etti."
  },
  {
   "tr": "Çok endişelendi."
  },
  {
   "tr": "Her yeri aradı."
  },
  {
   "tr": "Neyse ki nazik bir hanım cüzdanı bir koltukta buldu ve personele verdi."
  },
  {
   "tr": "Mark rahatladı ve kadına teşekkür etti."
  }
 ],
