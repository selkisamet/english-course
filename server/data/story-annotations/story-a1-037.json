 "source": "manual",
 "sentences": [
  {
   "tr": "Ekim ayı ve sonbahar geldi."
  },
  {
   "tr": "Ağaçlardaki yapraklar kırmızı, turuncu ve sarı."
  },
  {
   "tr": "Her gün daha çok yaprak yere düşüyor."
  },
  {
   "tr": "Hava daha serin ve sık sık yağmur yağıyor."
  },
  {
   "tr": "Çocuklar montları ve botlarıyla okula yürüyor."
  },
  {
   "tr": "Yaprakların içinde zıplamaya bayılıyorlar."
  },
  {
   "tr": "Parkta insanlar bu güzel renklerin fotoğrafını çekiyor."
  },
  {
   "tr": "Sonbahar en sevdiğim mevsim."
  }
 ],
