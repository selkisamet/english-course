 "source": "manual",
 "sentences": [
  {
   "tr": "Varoluşun görkemli tiyatrosunda sessizlik güçlü bir varlıktır."
  },
  {
   "tr": "Yok olmakta olan lehçeleri inceleyen bir dilbilimci olan Eleanor, kelimelerin yalnızca yüzeydeki bir katman olduğunu anlamıştı."
  },
  {
   "tr": "Büyük şehre döndüğünde derin bir yerinden kopmuşluk hissetti."
  },
  {
   "tr": "Eski kitapçılarda teselli buldu."
  },
  {
   "tr": "Kuramı, gerçek anlayışın söylenenden değil söylenmeden bırakılandan doğduğunu savunuyor ve çağdaş dilbilim kuramına meydan okuyordu."
  }
 ],
