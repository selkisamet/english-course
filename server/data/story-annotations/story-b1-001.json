{
 "storyId": "story-b1-001",
 "textHash": "fbf18248adc5",
 "source": "manual",
 "sentences": [
  {
   "tr": "Julia üç yıldır grafik tasarımcı olarak çalışıyor."
  },
  {
   "tr": "Kısa süre önce ünlü bir teknoloji şirketindeki bir pozisyona başvurdu."
  },
  {
   "tr": "Mülakat dündü."
  },
  {
   "tr": "Gergindi ama soruları kendinden emin bir şekilde yanıtladı."
  },
  {
   "tr": "Önceki görevinde sorunları nasıl çözdüğünü anlattı."
  },
  {
   "tr": "Sonunda müdür gülümsedi."
  },
  {
   "tr": "Julia şimdi rahatlamış hissediyor."
  },
  {
   "tr": "İşi alabilir de almayabilir de ama elinden gelenin en iyisini yaptı."
  }
 ],
