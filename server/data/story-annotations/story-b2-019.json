 "textHash": "deafdb6f032f",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ayla her zaman yurt dışında tıp okumayı hayal etmişti ama ailesi okul ücretlerini karşılayamıyordu."
  },
  {
   "tr": "Kişisel niyet mektubunu yazıp yeniden yazarak uluslararası bir bursa başvurusunu hazırlamakla aylar geçirdi."
  },
  {
   "tr": "Öğretmenlerinden referans mektubu da istedi ve mülakat için bir arkadaşıyla pratik yaptı."
  },
  {
   "tr": "E-posta sonunda geldiğinde açamayacak kadar gergindi."
  },
  {
   "tr": "Kız kardeşi e-postayı yüksek sesle okudu: tam burslu olarak kabul edilmişti."
  },
  {
   "tr": "Bu, yıllarca süren sıkı çalışmanın sonucuydu."
  }
 ],
