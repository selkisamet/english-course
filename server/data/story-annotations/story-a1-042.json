 "source": "manual",
 "sentences": [
  {
   "tr": "Ali on yaşında ve şehirdeki büyük bir okula gidiyor."
  },
  {
   "tr": "İlk dersi saat dokuzda."
  },
  {
   "tr": "Pazartesileri İngilizce, matematik ve resim dersi var."
  },
  {
   "tr": "İngilizce en sevdiği ders."
  },
  {
   "tr": "Öğle yemeği saatinde arkadaşlarıyla okul bahçesinde yemek yiyor."
  },
  {
   "tr": "Öğleden sonra basketbol oynuyorlar."
  },
  {
   "tr": "Okul üç buçukta bitiyor ve Ali kız kardeşiyle eve yürüyor."
  }
 ],
