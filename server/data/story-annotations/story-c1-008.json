 "sentences": [
  {
   "tr": "Liderlik çoğu zaman idealleştirilir, oysa gerçekte yalnızlıkla doludur."
  },
  {
   "tr": "CEO, şirketi batmaktan kurtarmak için şirketi küçültme gibi acı bir karar vermek zorunda kaldı."
  },
  {
   "tr": "Yüzlerce insanın geçiminin yükünü omuzlarında taşıdı."
  },
  {
   "tr": "Gerçek karakter tam da bu kritik anlarda ortaya çıkar ve sıradan bir yöneticiyi gerçek bir liderden ayırır."
  }
