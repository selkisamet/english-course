{
 "storyId": "story-a2-024",
 "textHash": "b71dc684f6c2",
 "source": "manual",
 "sentences": [
  {
   "tr": "Tom ve arkadaşı Jack okuldan sonra sokakta futbol oynuyorlardı."
  },
  {
   "tr": "Jack topa çok sert vurdu ve top Bayan Green'in penceresine uçtu."
  },
  {
   "tr": "Cam küçük parçalara ayrıldı."
  },
  {
   "tr": "Çocuklar korktu ve Jack kaçmak istedi."
  },
  {
   "tr": "Ama Tom, \"Hayır, ona söylemeliyiz.\" dedi."
  },
  {
   "tr": "Kadının kapısını çaldılar ve özür dilediler."
  },
  {
   "tr": "Bayan Green mutlu değildi ama dürüst davrandıkları için memnundu."
  },
  {
   "tr": "Çocuklar yeni pencerenin parasını harçlıklarıyla ödediler."
  }
 ],
