 "source": "manual",
 "sentences": [
  {
   "tr": "Londra'da yaşıyorum."
  },
  {
   "tr": "Kışın hava soğuk."
  },
  {
   "tr": "Sık sık yağmur yağar."
  },
  {
   "tr": "Bazen kar yağar."
  },
  {
   "tr": "Kar yağınca şehir beyaz ve güzel görünür."
  },
  {
   "tr": "İnsanlar sıcak tutan montlar ve şapkalar giyer."
  },
  {
   "tr": "Kışın sıcak içecekler içmeyi severim."
  },
  {
   "tr": "Evde kalıp film izlerim."
  },
  {
   "tr": "Günler kısa, geceler uzundur."
  },
  {
   "tr": "Karı yağmura tercih ederim."
  }
 ],
