{
 "storyId": "story-b1-044",
 "textHash": "72f11e9862df",
 "source": "manual",
 "sentences": [
  {
   "tr": "Daniel'ın en yakın arkadaşı ondan düğününde bir konuşma yapmasını istediğinde Daniel hemen evet dedi."
  },
  {
   "tr": "Ama gün yaklaştıkça giderek daha çok gerildi."
  },
  {
   "tr": "Daha önce hiç bu kadar çok insanın önünde konuşmamıştı."
  },
  {
   "tr": "Konuşmayı dikkatle yazdı ve her akşam aynanın karşısında prova yaptı."
  },
  {
   "tr": "Düğün günü ilk başta elleri titriyordu."
  },
  {
   "tr": "Ama misafirler ilk şakasına gülünce rahatladı."
  },
  {
   "tr": "Konuşmadan sonra herkes ayağa kalktı ve alkışladı."
  }
 ],
