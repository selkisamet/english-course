{
 "storyId": "story-a1-046",
 "textHash": "e0d4f7c484a2",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kenji Japonyalı ve ofiste yeni."
  },
  {
   "tr": "Kimseyi tanımıyor."
  },
  {
   "tr": "Öğle yemeğinde tek başına yiyor."
  },
  {
   "tr": "Çarşamba günü bir kadın onun masasına oturuyor."
  },
  {
   "tr": "\"Merhaba, ben Laura,\" diyor."
  },
  {
   "tr": "\"Nerelisin?\""
  },
  {
   "tr": "Ülkelerinden, ailelerinden ve en sevdikleri yemeklerden konuşuyorlar."
  },
  {
   "tr": "Artık her gün birlikte öğle yemeği yiyorlar."
  },
  {
   "tr": "Kenji mutlu çünkü yeni bir arkadaşı var."
  }
 ],
