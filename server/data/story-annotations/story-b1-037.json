{
 "storyId": "story-b1-037",
 "textHash": "87fb6bc8934e",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kasabanın eski kesiminde ikinci el kitap satan küçük bir dükkân var."
  },
  {
   "tr": "Sahibi Bayan Grant, dükkânı otuz yıldan fazladır işletiyor."
  },
  {
   "tr": "Raflar tavana kadar uzanıyor ve her yerde, hatta merdivenlerde bile kitap var."
  },
  {
   "tr": "Müşteriler orada nadir kitaplar arayarak çoğu zaman saatler geçiriyor."
  },
  {
   "tr": "Hiçbir şey düzenli görünmese de Bayan Grant her kitabın tam olarak nerede olduğunu biliyor."
  },
  {
   "tr": "Birçok öğrenci geliyor çünkü kitaplar diğer dükkânlardakinden çok daha ucuz."
  }
 ],
