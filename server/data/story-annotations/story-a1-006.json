 "source": "manual",
 "sentences": [
  {
   "tr": "Resim yapmayı severim."
  },
  {
   "tr": "En sevdiğim etkinlik bu."
  },
  {
   "tr": "Birçok rengim var: kırmızı, mavi, yeşil ve sarı."
  },
  {
   "tr": "Hafta sonları resim yaparım."
  },
  {
   "tr": "Genellikle çiçek ve ağaç resimleri yaparım."
  },
  {
   "tr": "Bazen hayvan resmi yaparım."
  },
  {
   "tr": "Odam resimlerimle dolu."
  },
  {
   "tr": "Annem \"Sen iyi bir ressamsın.\" der."
  },
  {
   "tr": "Bu beni mutlu hissettirir."
  },
  {
   "tr": "Gelecekte ünlü olmak istiyorum."
  }
 ],
