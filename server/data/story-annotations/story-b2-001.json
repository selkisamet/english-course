 "source": "manual",
 "sentences": [
  {
   "tr": "Elena yerel tarihi araştırırken bir rafın arkasına saklanmış tozlu bir kitap buldu."
  },
  {
   "tr": "Kitapta, Clara adında bir kadının 19. yüzyılda yazdığı mektuplar vardı."
  },
  {
   "tr": "Elena, Clara'nın bir hazine saklamış olduğunu fark etti."
  },
  {
   "tr": "İpuçlarını çözdükten sonra Elena saat kulesinin yakınını kazdı ve bir kutu altın para buldu."
  },
  {
   "tr": "Hazinenin herkes görebilsin diye müzeye bağışlanması gerektiğine karar verdi."
  }
 ],
