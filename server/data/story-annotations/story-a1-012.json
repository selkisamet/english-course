 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün pazar ve yağmur yağıyor."
  },
  {
   "tr": "Dışarı çıkamıyorum."
  },
  {
   "tr": "Erkek kardeşim ve ben annemle babamla evdeyiz."
  },
  {
   "tr": "Babam kanepede kitap okuyor."
  },
  {
   "tr": "Annem mutfakta çorba pişiriyor."
  },
  {
   "tr": "Kardeşimle yerde oyun oynuyoruz."
  },
  {
   "tr": "Sonra birlikte film izliyoruz."
  },
  {
   "tr": "Çorba sıcak ve çok güzel."
  },
  {
   "tr": "Ailemle evde geçen yağmurlu günleri severim."
  }
 ],
