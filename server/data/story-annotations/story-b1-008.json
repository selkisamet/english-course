 "source": "manual",
 "sentences": [
  {
   "tr": "Jenny parkta yürürken tasmasız bir köpek buldu."
  },
  {
   "tr": "Kaybolmuş ve aç görünüyordu."
  },
  {
   "tr": "Onu orada bırakamazdı, bu yüzden eve götürdü."
  },
  {
   "tr": "Köpeğin fotoğrafını sosyal medyada paylaştı."
  },
  {
   "tr": "İki saat sonra bir adam onunla iletişime geçti."
  },
  {
   "tr": "Sevinçten ağlıyordu."
  },
  {
   "tr": "Köpek onun en iyi arkadaşıydı."
  },
  {
   "tr": "Buluştuklarında köpek sevinçle zıpladı."
  },
  {
   "tr": "Jenny onlara yardım ettiği için çok mutlu oldu."
  }
 ],
