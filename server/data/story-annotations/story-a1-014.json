 "textHash": "04de865aacad",
 "source": "manual",
 "sentences": [
  {
   "tr": "Büyükannem deniz kenarında küçük bir evde yaşıyor."
  },
  {
   "tr": "Çok güzel bir bahçesi var."
  },
  {
   "tr": "Kırmızı çiçekler, sarı çiçekler ve büyük bir elma ağacı var."
  },
  {
   "tr": "Her yaz onu iki haftalığına ziyaret ederim."
  },
  {
   "tr": "Sabahları bitkileri birlikte sularız."
  },
  {
   "tr": "Öğleden sonraları ağacın altında oturup soğuk meyve suyu içeriz."
  },
  {
   "tr": "Büyükannem bana hayatıyla ilgili hikâyeler anlatır."
  },
  {
   "tr": "Onun bahçesini çok severim."
  }
 ],
