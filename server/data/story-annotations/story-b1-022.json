{
 "storyId": "story-b1-022",
 "textHash": "874c2d6223e3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Eve dönüş uçuşundan iki gün önce Tom pasaportunun kayıp olduğunu fark etti."
  },
  {
   "tr": "Otel odasını ve çantalarını aradı ama hiçbir yerde bulamadı."
  },
  {
   "tr": "Paniğe kapılmaya başladı."
  },
  {
   "tr": "Otel resepsiyon görevlisi ona önce polise, sonra da büyükelçiliğine gitmesini söyledi."
  },
  {
   "tr": "Büyükelçilikteki görevliler çok yardımseverdi."
  },
  {
   "tr": "Ertesi sabah ona geçici bir pasaport verdiler ve Tom uçağına zamanında yetişti."
  },
  {
   "tr": "Artık telefonunda her zaman pasaportunun bir kopyasını saklıyor."
  }
 ],
