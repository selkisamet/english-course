{
 "storyId": "story-b1-013",
 "textHash": "18bd864cf20d",
 "source": "manual",
 "sentences": [
  {
   "tr": "Lucy her cumartesi sabahı kasabasının dışındaki bir hayvan barınağında gönüllü çalışıyor."
  },
  {
   "tr": "Bunu iki yıldır yapıyor."
  },
  {
   "tr": "Görevi köpekleri beslemek, kafeslerini temizlemek ve onları yürüyüşe çıkarmak."
  },
  {
   "tr": "Hayvanların bazıları sokaklarda bulundu, bu yüzden insanlardan sık sık korkuyorlar."
  },
  {
   "tr": "Lucy onlara karşı çok sabırlı."
  },
  {
   "tr": "Bir köpek yeni bir yuva bulduğunda hem üzülüyor hem de gurur duyuyor."
  },
  {
   "tr": "Gönüllü çalışmanın onu daha mutlu biri yaptığını söylüyor."
  }
 ],
