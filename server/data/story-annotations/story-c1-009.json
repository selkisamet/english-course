 "sentences": [
  {
   "tr": "Dava, en deneyimli avukatları bile zorlayan karmaşık bir labirentti."
  },
  {
   "tr": "Savunma, yasanın belirsiz olduğunu ve yoruma açık olduğunu savundu."
  },
  {
   "tr": "Buna karşılık iddia makamı, önceki davalara sıkı sıkıya bağlı kalmaya dayandı."
  },
  {
   "tr": "Yargıcın kararı gelecekteki davalar için bir standart belirleyecek ve yasanın toplumsal normlarla sürekli gelişen canlı bir varlık olduğunu gözler önüne serecekti."
  }
 ],
