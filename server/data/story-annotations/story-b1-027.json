{
 "storyId": "story-b1-027",
 "textHash": "71780fe09f68",
 "source": "manual",
 "sentences": [
  {
   "tr": "Üç yıl önce Ahmed mühendislik okumak için Mısır'dan Kanada'ya taşındı."
  },
  {
   "tr": "Her şey farklıydı: hava, yemekler, hatta insanların birbirini selamlama şekli bile."
  },
  {
   "tr": "İlk kış çok zordu çünkü daha önce hiç bu kadar çok kar görmemişti."
  },
  {
   "tr": "Ailesini de çok özledi."
  },
  {
   "tr": "Ancak bir öğrenci kulübüne katıldı ve birçok ülkeden insanla tanıştı."
  },
  {
   "tr": "Şimdi çok iyi İngilizce konuşuyor ve üniversiteyi bitirdikten sonra Kanada'da kalmaya karar verdi."
  }
 ],
