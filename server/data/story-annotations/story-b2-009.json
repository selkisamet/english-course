 "storyId": "story-b2-009",
 "textHash": "a54d41a9f595",
 "source": "manual",
 "sentences": [
  {
   "tr": "Clara eskiden yoganın yalnızca esnek insanlar için olduğunu düşünürdü."
  },
  {
   "tr": "Ancak bel ağrısı çektikten sonra ona yogayı denemesi tavsiye edildi."
  },
  {
   "tr": "Altı aydır derslere katılıyor."
  },
  {
   "tr": "Ağrısı geçmekle kalmadı, kendini çok daha sakin de hissediyor."
  },
  {
   "tr": "Yoganın fiziksel esneklik kadar zihinsel güçle de ilgili olduğunu fark etti."
  }
 ],
