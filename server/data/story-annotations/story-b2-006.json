 "textHash": "cf3b0b37de2b",
 "source": "manual",
 "sentences": [
  {
   "tr": "Yardım galasını düzenlemek Linda için önemli bir sorumluluktu."
  },
  {
   "tr": "İkram hizmetini, müziği ve davetli listelerini koordine etmesi gerekiyordu."
  },
  {
   "tr": "Pes etmek istediği anlar oldu."
  },
  {
   "tr": "Ancak etkinlik gecesi her şey sorunsuz ilerledi."
  },
  {
   "tr": "Yerel hastane için elli bin dolardan fazla para topladılar."
  },
  {
   "tr": "Linda, toplumun bir araya geldiğini görünce derin bir başarı duygusu hissetti."
  }
 ],
