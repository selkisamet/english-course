 "source": "manual",
 "sentences": [
  {
   "tr": "Mevsim yaz."
  },
  {
   "tr": "Güneş sıcak ve parlak."
  },
  {
   "tr": "Tom ve arkadaşları plajda."
  },
  {
   "tr": "Deniz mavi ve temiz."
  },
  {
   "tr": "Tom suda yüzüyor."
  },
  {
   "tr": "Arkadaşı Mike kumda bir oyun oynuyor."
  },
  {
   "tr": "Lisa ilginç bir kitap okuyor."
  },
  {
   "tr": "Çok mutlular."
  },
  {
   "tr": "Öğleden sonra saat 1'de birlikte öğle yemeği yiyorlar."
  },
  {
   "tr": "Sandviç yiyip soğuk içecekler içiyorlar."
  },
  {
   "tr": "Daha sonra kumdan büyük bir kale yapıyorlar."
  }
 ],
