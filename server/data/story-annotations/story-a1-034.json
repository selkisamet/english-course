 "textHash": "04e9502ef7dc",
 "source": "manual",
 "sentences": [
  {
   "tr": "Carlos dağlarda küçük bir köyde yaşıyor."
  },
  {
   "tr": "Köyde sadece elli ev var."
  },
  {
   "tr": "Bir okul, bir dükkân ve küçük bir kilise var."
  },
  {
   "tr": "Herkes birbirini tanıyor."
  },
  {
   "tr": "Sabahları hava temiz ve soğuk."
  },
  {
   "tr": "Carlos arkadaşlarıyla okula yürüyor."
  },
  {
   "tr": "Akşamları insanlar evlerinin önünde oturup sohbet ediyor."
  },
  {
   "tr": "Carlos köyündeki sakin hayatı çok seviyor."
  }
 ],
