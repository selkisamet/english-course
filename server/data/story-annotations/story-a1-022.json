 "source": "manual",
 "sentences": [
  {
   "tr": "Pazar günü Mia sınıfıyla hayvanat bahçesine gidiyor."
  },
  {
   "tr": "Hayvanat bahçesi büyük ve çok sayıda hayvan var."
  },
  {
   "tr": "Önce aslanları görüyorlar."
  },
  {
   "tr": "Aslanlar güneşte uyuyor."
  },
  {
   "tr": "Sonra maymunları ziyaret ediyorlar."
  },
  {
   "tr": "Maymunlar komik ve çocuklar gülüyor."
  },
  {
   "tr": "Mia'nın en sevdiği hayvan fil."
  },
  {
   "tr": "Çok büyük ve gri."
  },
  {
   "tr": "Günün sonunda herkes yorgun ama mutlu."
  }
 ],
