{
 "storyId": "story-a2-037",
 "textHash": "37057aff3fcf",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen kış işten eve dönerken arabam yolun ortasında durdu."
  },
  {
   "tr": "Hava karanlık ve çok soğuktu, telefonumun şarjı da bitmişti."
  },
  {
   "tr": "Ne yapacağımı bilmiyordum."
  },
  {
   "tr": "Sonra genç bir adam arabasını durdurdu ve yardıma ihtiyacım olup olmadığını sordu."
  },
  {
   "tr": "Telefonundan bir tamirhaneyi aradı ve bir saat boyunca benimle bekledi."
  },
  {
   "tr": "Tamirci geldiğinde genç adama biraz para vermek istedim ama o hayır dedi."
  },
  {
   "tr": "Onun iyiliğini asla unutmayacağım."
  }
 ],
