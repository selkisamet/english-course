{
 "storyId": "story-a1-013",
 "textHash": "012de8508a01",
 "source": "manual",
 "sentences": [
  {
   "tr": "Ben bugün hasta."
  },
  {
   "tr": "Kötü bir soğuk algınlığı var ve başı ağrıyor."
  },
  {
   "tr": "Annesi onu doktora götürüyor."
  },
  {
   "tr": "Doktor, gözlüklü uzun boylu bir kadın."
  },
  {
   "tr": "Boğazına bakıyor ve göğsünü dinliyor."
  },
  {
   "tr": "\"Dinlenmen gerekiyor,\" diyor."
  },
  {
   "tr": "\"Bol su iç ve iki gün yatakta kal.\""
  },
  {
   "tr": "Ben eve gidip uyuyor."
  },
  {
   "tr": "Ertesi gün kendini daha iyi hissediyor."
  }
 ],
