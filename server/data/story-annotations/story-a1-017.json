 "source": "manual",
 "sentences": [
  {
   "tr": "Güneşli bir gün ve Anna öğle yemeğini parkta yiyor."
  },
  {
   "tr": "Parkın yakınındaki bir ofiste çalışıyor."
  },
  {
   "tr": "Saat on ikide çantasını alıp dışarı çıkıyor."
  },
  {
   "tr": "Bir ağacın altındaki bankta oturuyor."
  },
  {
   "tr": "Bir sandviç ve bir portakal yiyor."
  },
  {
   "tr": "Çocuklar çimenlerde futbol oynuyor, kuşlar ağaçlarda ötüyor."
  },
  {
   "tr": "Kırk dakika sonra Anna işine geri dönüyor."
  }
