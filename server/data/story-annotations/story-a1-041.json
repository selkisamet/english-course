 "source": "manual",
 "sentences": [
  {
   "tr": "Saat sabahın sekizi ve Olivia işe geç kalıyor."
  },
  {
   "tr": "Anahtarını bulamıyor."
  },
  {
   "tr": "Ne çantasında ne de masanın üstünde."
  },
  {
   "tr": "Kanepenin altına ve mutfağa bakıyor."
  },
  {
   "tr": "Sonra kocasını arıyor."
  },
  {
   "tr": "Kocası \"Montuna bak,\" diyor."
  },
  {
   "tr": "Olivia elini montunun içine sokuyor ve anahtar orada!"
  },
  {
   "tr": "Gülüyor ve otobüs durağına koşuyor."
  }
 ],
