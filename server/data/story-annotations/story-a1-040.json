 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün Anneler Günü."
  },
  {
   "tr": "Tom ve kız kardeşi anneleri için pasta yapmak istiyor."
  },
  {
   "tr": "Babaları mutfakta onlara yardım ediyor."
  },
  {
   "tr": "Büyük bir kâseye şeker, yumurta, tereyağı ve süt koyuyorlar."
  },
  {
   "tr": "Tom ve kız kardeşi büyük bir kaşık kullanıyor."
  },
  {
   "tr": "Sonra babaları pastayı kırk dakikalığına fırına koyuyor."
  },
  {
   "tr": "Mutfak çok güzel kokuyor."
  },
  {
   "tr": "Anneleri hediyesinden çok memnun."
  }
 ],
