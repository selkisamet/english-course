{
 "storyId": "story-b1-034",
 "textHash": "00986b477475",
 "source": "manual",
 "sentences": [
  {
   "tr": "Leo büyükbabasının eski bisikletini garajda bulduğunda bisiklet toz içindeydi ve lastikleri inikti."
  },
  {
   "tr": "Onu kendisi tamir etmeye karar verdi."
  },
  {
   "tr": "Nasıl yapılacağını öğrenmek için internette birkaç video izledi."
  },
  {
   "tr": "Önce bütün bisikleti temizledi ve lastikleri değiştirdi."
  },
  {
   "tr": "Sonra frenleri ve zinciri onardı."
  },
  {
   "tr": "Üç hafta sonu sürdü ama sonunda bisiklet hazırdı."
  },
  {
   "tr": "Artık her gün bisikletiyle okula gidiyor ve büyükbabası onunla çok gurur duyuyor."
  }
 ],
