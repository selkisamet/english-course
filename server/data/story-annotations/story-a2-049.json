{
 "storyId": "story-a2-049",
 "textHash": "647b4dff4b95",
 "source": "manual",
 "sentences": [
  {
   "tr": "Okulumuzun futbol takımı geçen cumartesi şehir kupasının finalinde oynadı."
  },
  {
   "tr": "Yüzlerce öğrenci ve veli izlemeye geldi."
  },
  {
   "tr": "Diğer takım çok iyiydi ve yirmi dakika sonra gol attılar."
  },
  {
   "tr": "İkinci yarıda takımımız çok daha iyi oynadı ve Ali bizim için bir gol attı."
  },
  {
   "tr": "Sonra, maçın bitmesine iki dakika kala kaptanımız topu ağlara gönderdi."
  },
  {
   "tr": "Kazandık!"
  },
  {
   "tr": "Herkes sahaya koştu ve birlikte kutladı."
  }
 ],
