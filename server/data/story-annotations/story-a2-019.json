{
 "storyId": "story-a2-019",
 "textHash": "ead7b22bf987",
 "source": "manual",
 "sentences": [
  {
   "tr": "Cuma öğleden sonra Sam bisikletiyle okuldan eve dönüyordu."
  },
  {
   "tr": "Yağmur yağıyordu ve yol ıslaktı."
  },
  {
   "tr": "Birden önüne bir kedi fırladı."
  },
  {
   "tr": "Sam hemen durdu ama bisikletten düştü ve dizini incitti."
  },
  {
   "tr": "Bir kadın kazayı gördü ve ona yardım etti."
  },
  {
   "tr": "Kadın, Sam'in anne babasını aradı ve babası onu almaya geldi."
  },
  {
   "tr": "Doktor dizinin iyi olduğunu söyledi."
  },
  {
   "tr": "Artık Sam yağmur yağınca bisiklete hep daha yavaş biniyor."
  }
 ],
