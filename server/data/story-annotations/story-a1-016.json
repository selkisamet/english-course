 "source": "manual",
 "sentences": [
  {
   "tr": "Bugün Tom'un doğum günü."
  },
  {
   "tr": "Yedi yaşında."
  },
  {
   "tr": "Annesiyle babası ona evde küçük bir parti veriyor."
  },
  {
   "tr": "Okuldan altı arkadaşı partiye geliyor."
  },
  {
   "tr": "Bahçede oyun oynuyor, pasta ve dondurma yiyorlar."
  },
  {
   "tr": "Tom bir sürü hediye alıyor."
  },
  {
   "tr": "En sevdiği hediye, büyükannesiyle büyükbabasından gelen kırmızı bir bisiklet."
  },
  {
   "tr": "Akşam Tom yorgun ama çok mutlu."
  }
 ],
