{
 "storyId": "story-a1-045",
 "textHash": "4561f3fac79a",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bay Evans, Avustralya'daki oğluna küçük bir kutu göndermek istiyor."
  },
  {
   "tr": "Şehir merkezindeki postaneye gidiyor."
  },
  {
   "tr": "Sırada beş kişi var."
  },
  {
   "tr": "On dakika bekliyor."
  },
  {
   "tr": "Sonra genç bir kadın \"Size yardım edebilir miyim?\" diye soruyor."
  },
  {
   "tr": "Kutuyu ona veriyor, kadın da kutuyu teraziye koyuyor."
  },
  {
   "tr": "Kadın \"On iki sterlin,\" diyor."
  },
  {
   "tr": "Bay Evans parayı ödüyor ve teşekkür ediyor."
  }
 ],
