 "source": "manual",
 "sentences": [
  {
   "tr": "Emma her cuma trenle şehre gider."
  },
  {
   "tr": "Orada teyzesini ziyaret eder."
  },
  {
   "tr": "Tren sabah saat dokuzda kalkar."
  },
  {
   "tr": "Emma istasyonda bilet alır ve perona bekler."
  },
  {
   "tr": "Tren hızlı ve temizdir."
  },
  {
   "tr": "Emma pencere kenarına oturur ve tarlalara, ağaçlara ve küçük köylere bakar."
  },
  {
   "tr": "Yolculuk bir saat sürer."
  },
  {
   "tr": "Teyzesi onu istasyonda bekler."
  }
 ],
