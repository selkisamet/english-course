{
 "storyId": "story-b1-019",
 "textHash": "54b8c6904cb8",
 "source": "manual",
 "sentences": [
  {
   "tr": "Bay ve Bayan Patel yirmi yıldır sokağımızda küçük bir bakkal işletiyor."
  },
  {
   "tr": "Sabah yedide açıp gece onda kapatıyorlar."
  },
  {
   "tr": "Çocukları okuldan sonra ve hafta sonları onlara yardım ediyor."
  },
  {
   "tr": "Yakınlarda birkaç büyük süpermarket açılmış olmasına rağmen birçok kişi hâlâ onların dükkânını tercih ediyor."
  },
  {
   "tr": "Patel'ler her müşteriyi adıyla tanıyor ve her zaman ailelerini soruyor."
  },
  {
   "tr": "Biri parasını unutursa ertesi gün ödeyebiliyor."
  }
 ],
