 "source": "manual",
 "sentences": [
  {
   "tr": "Dün Londra'ya uçmamız gerekiyordu ama uçuşumuz şiddetli bir fırtına yüzünden iptal edildi."
  },
  {
   "tr": "Havalimanında on saat mahsur kaldık."
  },
  {
   "tr": "Havayolu personeli bunalmıştı ve doğru bilgi veremedi."
  },
  {
   "tr": "Sonunda bize bir otel odası verildi."
  },
  {
   "tr": "Sinir bozucu bir deneyimdi ama çok hoş bir çiftle tanıştık ve bütün gece onlarla kâğıt oynadık."
  }
 ],
