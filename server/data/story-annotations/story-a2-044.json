 "textHash": "8a42eb307f00",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen cumartesi kuzenim Sara evlendi."
  },
  {
   "tr": "Düğün şehrin dışındaki güzel bir bahçedeydi."
  },
  {
   "tr": "Sara uzun beyaz bir gelinlik giydi, eşi de lacivert bir takım elbise giydi."
  },
  {
   "tr": "Yüzden fazla misafir geldi."
  },
  {
   "tr": "Törenden sonra ağaçların altında büyük bir akşam yemeği yedik."
  },
  {
   "tr": "Sonra bir müzik grubu çaldı ve herkes gece yarısına kadar dans etti."
  },
  {
   "tr": "Büyükannemle büyükbabam da dans etti ve herkes onları alkışladı."
  },
  {
   "tr": "Uzun bir gündü ama yılın en mutlu günüydü."
  }
 ],
