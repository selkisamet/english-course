{
 "storyId": "story-b1-040",
 "textHash": "dca216c571ed",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen sonbahar Ryan ve arkadaşı dağlarda doğa yürüyüşüne gittiler."
  },
  {
   "tr": "İnişte Ryan ıslak bir kayanın üzerinde kaydı ve ayak bileğini kötü incitti."
  },
  {
   "tr": "Yürüyemiyordu ve telefon çekmiyordu."
  },
  {
   "tr": "Arkadaşı ona su ve kalın bir mont verdi, sonra yardım bulmak için bir saat yürüdü."
  },
  {
   "tr": "İki saat sonra bir kurtarma ekibi geldi ve Ryan'ı dağdan aşağı taşıdı."
  },
  {
   "tr": "Doktor ayak bileğinin kırık olmadığını söyledi."
  },
  {
   "tr": "Artık Ryan bir yürüyüşten önce her zaman birine nereye gittiğini söylüyor."
  }
 ],
