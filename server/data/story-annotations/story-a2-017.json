{
 "storyId": "story-a2-017",
 "textHash": "b2d1a8fa9b0e",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen ay eşim ve ben dağlarda bir hafta sonu geçirdik."
  },
  {
   "tr": "Bir nehrin yanındaki küçük, ahşap bir otelde kaldık."
  },
  {
   "tr": "Hava temiz ve serindi, ortalık da çok sessizdi."
  },
  {
   "tr": "Cumartesi günü beş saat yürüdük ve birkaç güzel göl gördük."
  },
  {
   "tr": "Döndüğümüzde çok açtık ve otel lezzetli bir akşam yemeği sundu."
  },
  {
   "tr": "Pazar günü dinlendik ve kitaplarımızı okuduk."
  },
  {
   "tr": "Gelecek yıl oraya yine gitmek istiyoruz."
  }
 ],
