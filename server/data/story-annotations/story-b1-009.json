{
 "storyId": "story-b1-009",
 "textHash": "6f7f1804e5f3",
 "source": "manual",
 "sentences": [
  {
   "tr": "Kevin'in yeni işi için bir araca ihtiyacı var."
  },
  {
   "tr": "Yeni bir araba için yeterli parası yok, bu yüzden bir süredir ikinci el bir araba arıyor."
  },
  {
   "tr": "İnternette mavi bir sedan buldu."
  },
  {
   "tr": "Sahibi arabanın iyi durumda olduğunu söyledi."
  },
  {
   "tr": "Kevin dün onu incelemeye gitti."
  },
  {
   "tr": "Motorun sesi iyiydi ama lastikler eskiydi."
  },
  {
   "tr": "Daha düşük bir fiyat teklif etti ve sahibi kabul etti."
  },
  {
   "tr": "Kevin bu anlaşmadan memnun."
  }
 ],
