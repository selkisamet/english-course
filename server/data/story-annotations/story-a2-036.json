{
 "storyId": "story-a2-036",
 "textHash": "1c3bbf5bfc9b",
 "source": "manual",
 "sentences": [
  {
   "tr": "Geçen cuma Paul ve eşi akşam yemeği için yeni bir İtalyan restoranına gittiler."
  },
  {
   "tr": "Paul sebzeli balık, eşi de tavuklu salata sipariş etti."
  },
  {
   "tr": "Yirmi dakika sonra garson iki büyük tabak makarna getirdi."
  },
  {
   "tr": "Paul ona kibarca makarna sipariş etmediklerini söyledi."
  },
  {
   "tr": "Garson çok üzüldü ve tabakları mutfağa geri götürdü."
  },
  {
   "tr": "On dakika sonra doğru yemekle geri geldi."
  },
  {
   "tr": "Balık çok lezzetliydi ve restoran onlardan içeceklerin parasını almadı."
  }
 ],
