 "source": "manual",
 "sentences": [
  {
   "tr": "Agnes seksen yaşında, arazisinin kenarı boyunca bir sıra meşe ağacı dikti."
  },
  {
   "tr": "Meşelerin tam boylarına ulaşması kuşaklar sürdüğü ve Agnes onların gölgesinde asla oturamayacağı için komşuları şaşkına döndü."
  },
  {
   "tr": "Neden zahmet ettiği sorulduğunda, yalnızca bir zamanlar birinin de onun için ağaç diktiğini söyledi."
  },
  {
   "tr": "Meşeler artık evden daha uzun ve onu hiç tanımamış çocuklar her yaz onların altında oynuyor."
  }
 ],
