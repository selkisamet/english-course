{
 "storyId": "story-c2-039",
 "textHash": "bd241df6587b",
 "source": "manual",
 "sentences": [
  {
   "tr": "İşitmesi zayıflamaya başladığında kemancı, kariyerinin bittiğinden korktu."
  },
  {
   "tr": "Bir süre artık fark edemediği hatalardan utandığı için sahneye çıkmayı reddetti."
  },
  {
   "tr": "Sonra kendisinden genç bir meslektaşı onu küçük bir kilisede bir kez daha çalmaya ikna etti."
  },
  {
   "tr": "Durumundan habersiz olan dinleyiciler onu derin bir sessizlik içinde dinledi."
  },
  {
   "tr": "Konserden sonra yaşlı bir kadın ona hiçbir zaman bu kadar şefkatle çalınmış bir müzik duymadığını söyledi."
  }
 ],
