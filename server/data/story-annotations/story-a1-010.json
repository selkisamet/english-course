 "textHash": "ca6d76834eb9",
 "source": "manual",
 "sentences": [
  {
   "tr": "David gitar çalmak istiyor."
  },
  {
   "tr": "Yeni bir enstrümanı var."
  },
  {
   "tr": "Kahverengi ve güzel görünüyor."
  },
  {
   "tr": "Her salı ders alıyor."
  },
  {
   "tr": "Parmakları acıyor ama her gün pratik yapıyor."
  },
  {
   "tr": "Kolay şarkılar çalıyor."
  },
  {
   "tr": "Komşuları müziği duyuyor."
  },
  {
   "tr": "David mükemmel değil ama çok çalışıyor."
  },
  {
   "tr": "Kız arkadaşı için bir şarkı çalmak istiyor."
  },
  {
   "tr": "Bu konuda çok heyecanlı."
  }
 ],
