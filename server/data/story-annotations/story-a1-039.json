 "source": "manual",
 "sentences": [
  {
   "tr": "Hana sekiz yaşında ve yüzme bilmiyor."
  },
  {
   "tr": "Her salı okulunun yakınındaki havuzda yüzme dersi alıyor."
  },
  {
   "tr": "Öğretmeni Adam adında genç bir adam."
  },
  {
   "tr": "Çok sabırlı biri."
  },
  {
   "tr": "Hana önce yüzünü suya sokmayı öğreniyor."
  },
  {
   "tr": "Sonra kollarını ve bacaklarını hareket ettirmeyi öğreniyor."
  },
  {
   "tr": "On dersin sonunda Hana havuzun bir ucundan öbür ucuna yüzebiliyor!"
  }
 ],
